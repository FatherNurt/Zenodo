{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMW3ybDounNLIa4p2V+wI03"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":650},"id":"8RdUvJavr9HA","executionInfo":{"status":"ok","timestamp":1766870658787,"user_tz":300,"elapsed":166056,"user":{"displayName":"Michael Nowlin","userId":"15939787152312273307"}},"outputId":"3e2d2480-aed9-4cbc-970e-a622b33c8461"},"outputs":[{"output_type":"stream","name":"stdout","text":["🔍 No tensor in memory → upload your .npy/.npz now (or skip for DEMO MODE)\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-7060ce38-97f2-4240-8f43-f7a0b51cf295\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-7060ce38-97f2-4240-8f43-f7a0b51cf295\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["🚀 Tensor: DEMO_MODE (random fun data) | Shape: (400, 81) | DEMO: True\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/IPython/core/pylabtools.py:151: UserWarning: Glyph 127912 (\\N{ARTIST PALETTE}) missing from font(s) DejaVu Sans.\n","  fig.canvas.print_figure(bytes_io, **kw)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1400x800 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","🎯 REGIME MAP — PHI PROXIMITY EDITION 🎯\n","\n","short → 1.6181  |  dist=0.0001  →  10/10 ⭐⭐⭐⭐⭐ 🚨 PHI PROXIMITY ALERT! 🚨\n","long  → 1.6932  |  dist=0.0752  →  5/10 ⭐⭐✨ \n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["<h2 style='color:gold; text-align:center;'>🎊 CONFETTI TIME — PHI IS STRONG TONIGHT! 🎊</h2>"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Javascript object>"],"application/javascript":["\n","    function launchConfetti() {\n","      const duration = 5 * 1000;\n","      const animationEnd = Date.now() + duration;\n","      const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };\n","\n","      function randomInRange(min, max) {\n","        return Math.random() * (max - min) + min;\n","      }\n","\n","      const interval = setInterval(function() {\n","        const timeLeft = animationEnd - Date.now();\n","        if (timeLeft <= 0) return clearInterval(interval);\n","        const particleCount = 50 * (timeLeft / duration);\n","        confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));\n","        confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));\n","      }, 250);\n","    }\n","    launchConfetti();\n","    "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["<script src='https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js'></script>"]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","✨ All done! Check fun_report.json and the beautiful plot above.\n","Paste your real H3a tensor next time and watch the fireworks. 🚀\n"]}],"source":["# ╔══════════════════════════════════════════════════════════╗\n","# ║  H3a δ̂_TV Regime Map — EASY BUTTON 2.0 (FUN MODE)       ║\n","# ║  Cut-and-paste special for Phi7 🎄✨                      ║\n","# ╚══════════════════════════════════════════════════════════╝\n","\n","import numpy as np, os, json, matplotlib.pyplot as plt\n","from IPython.display import display, HTML, Javascript\n","PHI = (1 + np.sqrt(5)) / 2\n","\n","# -------------------------\n","# 0) INPUT RESOLUTION\n","# -------------------------\n","CANDIDATES = [\n","    \"H3a_windows_ranknorm\", \"windows_ranked_aligned\", \"signature_windows_final\",\n","    \"aligned_ranknorm_windows\", \"peak_centered_ranknorm\", \"W_normalized\",\n","    \"rank_windows_clean\",\n","]\n","\n","def _resolve_from_globals():\n","    g = globals()\n","    for name in CANDIDATES:\n","        if name in g:\n","            v = g[name]\n","            try:\n","                a = np.asarray(v, dtype=float)\n","                if a.ndim == 2 and a.shape[1] >= 16:\n","                    return name, a\n","            except: pass\n","    return None, None\n","\n","name_used, signature_windows = _resolve_from_globals()\n","DEMO_MODE = False\n","\n","if signature_windows is None:\n","    try:\n","        from google.colab import files\n","        print(\"🔍 No tensor in memory → upload your .npy/.npz now (or skip for DEMO MODE)\")\n","        up = files.upload()\n","        if up:\n","            fname = list(up.keys())[0]\n","            if fname.endswith(\".npy\"):\n","                signature_windows = np.load(fname)\n","                name_used = f\"uploaded:{fname}\"\n","            elif fname.endswith(\".npz\"):\n","                z = np.load(fname)\n","                key = list(z.keys())[0]\n","                signature_windows = z[key]\n","                name_used = f\"uploaded:{fname}[{key}]\"\n","    except: pass\n","\n","if signature_windows is None:\n","    DEMO_MODE = True\n","    signature_windows = np.random.rand(400, 81)\n","    name_used = \"DEMO_MODE (random fun data)\"\n","\n","W = np.asarray(signature_windows, dtype=float)\n","if W.ndim == 1: W = W[None,:]\n","n_windows, L = W.shape\n","\n","print(f\"🚀 Tensor: {name_used} | Shape: {W.shape} | DEMO: {DEMO_MODE}\")\n","\n","# -------------------------\n","# 1) δ̂_TV ESTIMATOR (same solid core)\n","# -------------------------\n","def block_average(x, m):\n","    n = (len(x) // m) * m\n","    return x[:n].reshape(-1, m).mean(axis=1) if n > 0 else np.array([])\n","\n","def total_variation(x):\n","    return float(np.sum(np.abs(np.diff(x)))) if len(x) >= 2 else np.nan\n","\n","def estimate_delta_TV(window, scales):\n","    eps_list, var_list = [], []\n","    for m in scales:\n","        y = block_average(window, int(m))\n","        v = total_variation(y)\n","        if np.isfinite(v) and v > 0 and len(y) >= 4:\n","            eps_list.append(float(m))\n","            var_list.append(float(v))\n","    if len(var_list) < 4: return np.nan\n","    log_eps = np.log(np.array(eps_list))\n","    log_var = np.log(np.array(var_list))\n","    slope, _ = np.polyfit(log_eps, log_var, 1)\n","    return float(-slope)\n","\n","max_m = max(2, L // 4)\n","raw = np.logspace(np.log10(2), np.log10(max_m), num=10)\n","candidate_scales = np.unique(np.round(raw).astype(int))\n","candidate_scales = candidate_scales[candidate_scales >= 2]\n","\n","def make_bands(scales, min_scales=4):\n","    scales = np.asarray(scales, dtype=int)\n","    q1, q2 = np.quantile(scales, [1/3, 2/3])\n","    bands = {\n","        \"short\": scales[scales <= q1],\n","        \"mid\":   scales[(scales > q1) & (scales <= q2)],\n","        \"long\":  scales[scales > q2]\n","    }\n","    for k in list(bands):\n","        if len(bands[k]) < min_scales:\n","            del bands[k]\n","    if len(bands) < 2:\n","        mid = int(np.median(scales))\n","        return {\"short\": scales[scales <= mid], \"long\": scales[scales > mid]}\n","    return bands\n","\n","bands = make_bands(candidate_scales)\n","band_colors = {\"short\": \"#FF6B6B\", \"mid\": \"#4ECDC4\", \"long\": \"#45B7D1\"}\n","\n","# -------------------------\n","# 2) COMPUTE + PLOT\n","# -------------------------\n","plt.figure(figsize=(14, 8))\n","all_deltas = {}\n","\n","for i, (band, scales) in enumerate(bands.items()):\n","    deltas = [estimate_delta_TV(W[j], scales) for j in range(n_windows)]\n","    deltas = np.array([d for d in deltas if np.isfinite(d)])\n","    all_deltas[band] = deltas\n","\n","    color = band_colors.get(band, \"gray\")\n","    plt.hist(deltas, bins=50, alpha=0.6, label=f\"{band} band (n={len(deltas)})\", color=color, edgecolor='black', linewidth=0.5)\n","    med = np.median(deltas)\n","    plt.axvline(med, color=color, linestyle='--', linewidth=2)\n","    plt.axvline(PHI, color='gold', linewidth=3, label='φ ≈ 1.618' if i==0 else \"\")\n","\n","plt.xlabel(\"δ̂_TV (roughness scaling exponent)\", fontsize=14)\n","plt.ylabel(\"Number of windows\", fontsize=14)\n","plt.title(\"🎨 H3a Signature Windows — Multiscale Roughness Distribution\", fontsize=16)\n","plt.legend(fontsize=12)\n","plt.grid(alpha=0.3)\n","plt.show()\n","\n","# -------------------------\n","# 3) SUMMARY & PHI PROXIMITY FUN\n","# -------------------------\n","def phi_strength(med, ci_width):\n","    if not np.isfinite(med): return 0\n","    dist = abs(med - PHI)\n","    if dist < 0.02: return 10\n","    elif dist < 0.05: return 8\n","    elif dist < 0.10: return 5\n","    elif dist < 0.20: return 3\n","    return 1\n","\n","regime_map = []\n","total_strength = 0\n","\n","print(\"\\n🎯 REGIME MAP — PHI PROXIMITY EDITION 🎯\\n\")\n","for band in bands:\n","    deltas = all_deltas[band]\n","    med = np.median(deltas)\n","    strength = phi_strength(med, 0.08)  # dummy CI for now\n","    total_strength += strength\n","    stars = \"⭐\" * (strength // 2) + (\"✨\" if strength % 2 else \"\")\n","    alert = \"🚨 PHI PROXIMITY ALERT! 🚨\" if strength >= 8 else \"\"\n","    regime_map.append({\n","        \"Band\": band,\n","        \"Median δ̂_TV\": f\"{med:.4f}\",\n","        \"Distance to φ\": f\"{abs(med-PHI):.4f}\",\n","        \"Phi Strength\": f\"{strength}/10 {stars}\",\n","        \"Alert\": alert\n","    })\n","    print(f\"{band:5} → {med:.4f}  |  dist={abs(med-PHI):.4f}  →  {strength}/10 {stars} {alert}\")\n","\n","# Confetti if we hit strong phi anywhere\n","if total_strength >= 15:\n","    display(HTML(\"<h2 style='color:gold; text-align:center;'>🎊 CONFETTI TIME — PHI IS STRONG TONIGHT! 🎊</h2>\"))\n","    display(Javascript(\"\"\"\n","    function launchConfetti() {\n","      const duration = 5 * 1000;\n","      const animationEnd = Date.now() + duration;\n","      const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };\n","\n","      function randomInRange(min, max) {\n","        return Math.random() * (max - min) + min;\n","      }\n","\n","      const interval = setInterval(function() {\n","        const timeLeft = animationEnd - Date.now();\n","        if (timeLeft <= 0) return clearInterval(interval);\n","        const particleCount = 50 * (timeLeft / duration);\n","        confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));\n","        confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));\n","      }, 250);\n","    }\n","    launchConfetti();\n","    \"\"\"))\n","    display(HTML(\"<script src='https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js'></script>\"))\n","\n","# Save quiet report too\n","report = {\"regime_map_fun\": regime_map, \"total_phi_strength\": total_strength, \"DEMO_MODE\": DEMO_MODE}\n","with open(\"fun_report.json\", \"w\") as f:\n","    json.dump(report, f, indent=2)\n","\n","print(\"\\n✨ All done! Check fun_report.json and the beautiful plot above.\")\n","print(\"Paste your real H3a tensor next time and watch the fireworks. 🚀\")"]},{"cell_type":"markdown","metadata":{"id":"0rK7AoitHYA8"},"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","\n","**Runtime → Run all.**\n","\n","This notebook:\n","1. Auto-detects your H3a rank-normalized signature window tensor if it exists in memory.\n","2. If not found, offers a one-click upload of a `.npy` or `.npz` tensor.\n","3. If neither is available, runs in clearly-labeled DEMO MODE.\n","\n","Outputs a **Regime Map table** plus a saved `report.json`.\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":108},"outputId":"2a3a2512-fb63-47b9-9ead-8c4ecfa41214","id":"ranoaZ5vHYA9"},"outputs":[{"name":"stdout","output_type":"stream","text":["No H3a tensor found in memory.\n","OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\n","OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\n"]},{"data":{"text/html":["\n","     <input type=\"file\" id=\"files-a3650acc-3e3e-4a92-8e70-1f28abbfd529\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-a3650acc-3e3e-4a92-8e70-1f28abbfd529\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "],"text/plain":["<IPython.core.display.HTML object>"]},"metadata":{},"output_type":"display_data"}],"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","# Runtime → Run all\n","#\n","# Purpose:\n","#   (1) Detect stable multiscale structure in H3a rank‑normalized signature windows\n","#   (2) Map where φ appears as a regime‑local attractor under null + perturbation controls\n","#\n","# What this notebook does NOT do:\n","#   - no mechanism claim\n","#   - no δ̂_TV → Hurst conversion claim\n","#   - no conflation with FUNt theoretical D≈1.2\n","#\n","# INPUT EXPECTATION:\n","#   A 2D tensor (n_windows, L), typically values in [0,1], e.g. (1278, 81).\n","#\n","# EASY BUTTON behavior:\n","#   A) If tensor already exists in memory under common upstream variable names, it auto‑uses it.\n","#   B) If not, it offers a one‑click upload of .npy or .npz (Colab).\n","#   C) If neither is available, it runs DEMO MODE (clearly labeled) so outputs appear.\n","\n","import numpy as np, os, json\n","\n","PHI = (1 + np.sqrt(5)) / 2\n","\n","# -------------------------\n","# 0) INPUT RESOLUTION (NO NAMEERROR)\n","# -------------------------\n","CANDIDATES = [\n","    \"H3a_windows_ranknorm\",\n","    \"windows_ranked_aligned\",\n","    \"signature_windows_final\",\n","    \"aligned_ranknorm_windows\",\n","    \"peak_centered_ranknorm\",\n","    \"W_normalized\",\n","    \"rank_windows_clean\",\n","]\n","\n","def _resolve_from_globals():\n","    g = globals()\n","    for name in CANDIDATES:\n","        if name in g:\n","            v = g[name]\n","            try:\n","                a = np.asarray(v, dtype=float)\n","                if a.ndim == 2 and a.shape[1] >= 16:\n","                    return name, a\n","            except Exception:\n","                pass\n","    return None, None\n","\n","name_used, signature_windows = _resolve_from_globals()\n","DEMO_MODE = False\n","\n","# Optional local path (if user wants to set it)\n","TENSOR_PATH = \"\"  # e.g., \"/content/H3a_windows_ranknorm.npy\" or \".npz\"\n","\n","if signature_windows is None and TENSOR_PATH and os.path.exists(TENSOR_PATH):\n","    if TENSOR_PATH.endswith(\".npy\"):\n","        signature_windows = np.load(TENSOR_PATH)\n","        name_used = f\"loaded:{TENSOR_PATH}\"\n","    elif TENSOR_PATH.endswith(\".npz\"):\n","        z = np.load(TENSOR_PATH)\n","        key = list(z.keys())[0]\n","        signature_windows = z[key]\n","        name_used = f\"loaded:{TENSOR_PATH}[{key}]\"\n","    else:\n","        raise ValueError(\"TENSOR_PATH must end in .npy or .npz\")\n","\n","# Colab upload helper (safe: user-controlled upload; no external calls)\n","if signature_windows is None:\n","    try:\n","        from google.colab import files\n","        print(\"No H3a tensor found in memory.\")\n","        print(\"OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\")\n","        print(\"OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\")\n","        up = files.upload()\n","        if up:\n","            fname = list(up.keys())[0]\n","            if fname.endswith(\".npy\"):\n","                signature_windows = np.load(fname)\n","                name_used = f\"uploaded:{fname}\"\n","            elif fname.endswith(\".npz\"):\n","                z = np.load(fname)\n","                key = list(z.keys())[0]\n","                signature_windows = z[key]\n","                name_used = f\"uploaded:{fname}[{key}]\"\n","            else:\n","                raise ValueError(\"Upload must be .npy or .npz containing the tensor.\")\n","    except Exception:\n","        pass\n","\n","# DEMO MODE fallback\n","if signature_windows is None:\n","    DEMO_MODE = True\n","    signature_windows = np.random.rand(400, 81)  # small-ish so it runs quickly anywhere\n","    name_used = \"DEMO_MODE_random_(400,81)\"\n","\n","W = np.asarray(signature_windows, dtype=float)\n","if W.ndim == 1:\n","    W = W[None, :]\n","n_windows, L = W.shape\n","\n","print(\"========================================\")\n","print(\"H3a δ̂_TV Regime Map — INPUT STATUS\")\n","print(\"========================================\")\n","print(\"Tensor source:\", name_used)\n","print(\"DEMO_MODE:\", DEMO_MODE)\n","print(\"Shape:\", W.shape)\n","print(\"Range:\", float(np.nanmin(W)), \"to\", float(np.nanmax(W)))\n","print(\"PHI:\", float(PHI))\n","assert L >= 16, \"Windows too short for multiscale slope fits.\"\n","\n","# -------------------------\n","# 1) REGIME MAP DIAGNOSTIC (OBSERVE‑ONLY)\n","# -------------------------\n","\n","# ---------- CORE ESTIMATOR: δ̂_TV ----------\n","def block_average(x, m):\n","    n = (len(x) // m) * m\n","    if n <= 0:\n","        return np.array([], dtype=float)\n","    return x[:n].reshape(-1, m).mean(axis=1)\n","\n","def total_variation(x):\n","    if len(x) < 2:\n","        return np.nan\n","    return float(np.sum(np.abs(np.diff(x))))\n","\n","def estimate_delta_TV(window, scales):\n","    eps_list, var_list = [], []\n","    for m in scales:\n","        y = block_average(window, int(m))\n","        v = total_variation(y)\n","        if np.isfinite(v) and v > 0 and len(y) >= 4:\n","            eps_list.append(float(m))\n","            var_list.append(float(v))\n","    if len(var_list) < 4:\n","        return np.nan\n","    log_eps = np.log(np.array(eps_list))\n","    log_var = np.log(np.array(var_list))\n","    slope, _ = np.polyfit(log_eps, log_var, 1)\n","    return float(-slope)\n","\n","# ---------- SCALE LADDER (min block size = 2) ----------\n","max_m = max(2, L // 4)\n","raw = np.logspace(np.log10(2), np.log10(max_m), num=10)\n","candidate_scales = np.unique(np.clip(np.round(raw), 2, max_m).astype(int))\n","candidate_scales = candidate_scales[candidate_scales >= 2]\n","print(\"candidate_scales:\", candidate_scales.tolist())\n","\n","# ---------- BAND SPLIT with MIN-SCALES GUARANTEE ----------\n","def make_bands(scales, min_scales=4):\n","    scales = np.asarray(scales, dtype=int)\n","    if len(scales) < (3 * min_scales):\n","        mid = int(np.median(scales))\n","        short = scales[scales <= mid]\n","        long  = scales[scales >= mid]\n","        return {\"short\": short, \"long\": long}\n","\n","    q1, q2 = np.quantile(scales, [1/3, 2/3])\n","    short = scales[scales <= q1]\n","    mid   = scales[(scales > q1) & (scales <= q2)]\n","    long  = scales[scales > q2]\n","\n","    bands = {\"short\": short, \"mid\": mid, \"long\": long}\n","\n","    if len(bands[\"mid\"]) < min_scales:\n","        if len(bands[\"short\"]) <= len(bands[\"long\"]):\n","            bands[\"short\"] = np.unique(np.concatenate([bands[\"short\"], bands[\"mid\"]]))\n","        else:\n","            bands[\"long\"]  = np.unique(np.concatenate([bands[\"mid\"], bands[\"long\"]]))\n","        del bands[\"mid\"]\n","\n","    for k in list(bands.keys()):\n","        if len(bands[k]) < min_scales:\n","            mid = int(np.median(scales))\n","            short = scales[scales <= mid]\n","            long  = scales[scales >= mid]\n","            return {\"short\": short, \"long\": long}\n","\n","    return bands\n","\n","bands = make_bands(candidate_scales, min_scales=4)\n","print(\"Bands:\", {k: v.tolist() for k, v in bands.items()})\n","\n","# ---------- SUMMARY / BOOTSTRAP ----------\n","def bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    n = len(x)\n","    if n < 5:\n","        return (np.nan, np.nan)\n","    rng = np.random.default_rng(seed)\n","    stats = np.empty(B, dtype=float)\n","    for b in range(B):\n","        stats[b] = np.median(x[rng.integers(0, n, size=n)])\n","    lo = float(np.quantile(stats, alpha/2))\n","    hi = float(np.quantile(stats, 1-alpha/2))\n","    return (lo, hi)\n","\n","def summarize(x):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    if len(x) == 0:\n","        return {}\n","    mean = float(np.mean(x))\n","    med  = float(np.median(x))\n","    sd   = float(np.std(x, ddof=1)) if len(x) > 1 else 0.0\n","    cv   = float(sd / mean) if mean != 0 else np.nan\n","    ci_lo, ci_hi = bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1)\n","    return {\n","        \"n\": int(len(x)),\n","        \"mean\": mean,\n","        \"median\": med,\n","        \"sd\": sd,\n","        \"CV\": cv,\n","        \"median_CI95\": (ci_lo, ci_hi),\n","        \"CI_width\": (ci_hi - ci_lo) if np.isfinite(ci_lo) and np.isfinite(ci_hi) else np.nan\n","    }\n","\n","# ---------- COMPUTE δ̂_TV PER BAND ----------\n","delta_per_band = {}\n","band_summaries = {}\n","for band, scales in bands.items():\n","    print(f\"Computing δ̂_TV band='{band}' scales={scales.tolist()} ...\")\n","    deltas = np.array([estimate_delta_TV(W[i], scales) for i in range(n_windows)], dtype=float)\n","    deltas = deltas[np.isfinite(deltas)]\n","    delta_per_band[band] = deltas\n","    band_summaries[band] = summarize(deltas)\n","\n","# ---------- NULLS (phi-targeted) ----------\n","def null_shuffle_ranks(w, rng):\n","    y = w.copy()\n","    rng.shuffle(y)\n","    return y\n","\n","def null_phase_randomize(w, rng):\n","    x = w - np.mean(w)\n","    X = np.fft.rfft(x)\n","    mag = np.abs(X)\n","    phase = np.angle(X)\n","    rand_phase = rng.uniform(-np.pi, np.pi, size=phase.shape)\n","    rand_phase[0] = phase[0]\n","    if len(rand_phase) > 1:\n","        rand_phase[-1] = phase[-1]\n","    Y = mag * np.exp(1j * rand_phase)\n","    return np.fft.irfft(Y, n=len(x))\n","\n","def null_random_monotone(L, rng):\n","    steps = np.abs(rng.normal(size=L))\n","    y = np.cumsum(steps)\n","    return (y - y.min()) / (y.max() - y.min() + 1e-12)\n","\n","def null_medians_for_band(kind, scales, B=200, seed=123, print_every=25):\n","    rng = np.random.default_rng(seed)\n","    meds = np.empty(B, dtype=float)\n","    for b in range(B):\n","        if (b % print_every) == 0:\n","            print(f\"[{kind}] {b}/{B}\")\n","        Dtmp = []\n","        for i in range(n_windows):\n","            w = W[i]\n","            if kind == \"shuffle\":\n","                w0 = null_shuffle_ranks(w, rng)\n","            elif kind == \"phase\":\n","                w0 = null_phase_randomize(w, rng)\n","            elif kind == \"monotone\":\n","                w0 = null_random_monotone(len(w), rng)\n","            else:\n","                raise ValueError(\"Unknown null kind.\")\n","            d = estimate_delta_TV(w0, scales)\n","            if np.isfinite(d):\n","                Dtmp.append(d)\n","        meds[b] = np.median(Dtmp) if len(Dtmp) else np.nan\n","    return meds[np.isfinite(meds)]\n","\n","null_kinds = [\"shuffle\", \"phase\", \"monotone\"]\n","B_NULL = 200 if not DEMO_MODE else 40  # demo runs faster\n","\n","pvals_per_band = {}\n","null_summary_per_band = {}\n","\n","for band, scales in bands.items():\n","    obs_med = band_summaries[band].get(\"median\", np.nan)\n","    if not np.isfinite(obs_med):\n","        continue\n","    print(f\"\\n=== Nulls: band '{band}' obs_median={obs_med:.6f} |obs-φ|={abs(obs_med-PHI):.6f} ===\")\n","    pvals, nsum = {}, {}\n","    for kind in null_kinds:\n","        nd = null_medians_for_band(kind, scales, B=B_NULL, seed=123, print_every=max(5, B_NULL//6))\n","        if len(nd) == 0:\n","            pvals[kind] = np.nan\n","            nsum[kind] = {}\n","            continue\n","        dev_obs = abs(obs_med - PHI)\n","        dev_null = np.abs(nd - PHI)\n","        p = float((np.sum(dev_null <= dev_obs) + 1) / (len(dev_null) + 1))\n","        pvals[kind] = p\n","        nsum[kind] = {\n","            \"n\": int(len(nd)),\n","            \"median\": float(np.median(nd)),\n","            \"CI95\": (float(np.quantile(nd, 0.025)), float(np.quantile(nd, 0.975))),\n","        }\n","        print(f\"  {kind:8s} null_median={nsum[kind]['median']:.6f}  p_phi={p:.6g}\")\n","    pvals_per_band[band] = pvals\n","    null_summary_per_band[band] = nsum\n","\n","# ---------- LIGHTWEIGHT PERTURBATION MEDIAN TRACKS ----------\n","def shift_window_edgepad(x, k):\n","    x = np.asarray(x)\n","    if k == 0:\n","        return x.copy()\n","    if k > 0:\n","        return np.concatenate([np.full(k, x[0]), x[:-k]])\n","    k2 = -k\n","    return np.concatenate([x[k2:], np.full(k2, x[-1])])\n","\n","noise_levels = [0.0, 0.05, 0.10]\n","jitter_shifts = [-3, -2, -1, 0, 1, 2, 3]\n","\n","sensitivity_per_band = {}\n","rng_sens = np.random.default_rng(999)\n","\n","for band, scales in bands.items():\n","    sens = {\"noise_median\": {}, \"jitter_median\": {}}\n","    for sigma in noise_levels:\n","        Wn = W + rng_sens.normal(0.0, sigma, size=W.shape)\n","        deltas = np.array([estimate_delta_TV(Wn[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"noise_median\"][sigma] = float(np.median(deltas)) if len(deltas) else np.nan\n","    for sh in jitter_shifts:\n","        Wj = np.vstack([shift_window_edgepad(W[i], sh) for i in range(n_windows)])\n","        deltas = np.array([estimate_delta_TV(Wj[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"jitter_median\"][sh] = float(np.median(deltas)) if len(deltas) else np.nan\n","    sensitivity_per_band[band] = sens\n","\n","# ---------- BREATH (bounded drift) ----------\n","def breath_pass_from_medians(medians, max_step=0.20):\n","    medians = np.asarray(medians, dtype=float)\n","    if not np.all(np.isfinite(medians)):\n","        return False\n","    steps = np.abs(np.diff(medians))\n","    return bool(np.all(steps <= max_step))\n","\n","band_order = list(bands.keys())\n","band_medians = [band_summaries[b].get(\"median\", np.nan) for b in band_order]\n","breath_pass = bool(breath_pass_from_medians(band_medians, max_step=0.20))\n","\n","# ---------- DECISIONS ----------\n","def structure_gate(summary, pvals, ciw_max=0.08, p_thresh=0.01):\n","    # NOTE: Structure gate intentionally does NOT enforce a strict CV cutoff.\n","    if not summary:\n","        return False\n","    if not (np.isfinite(summary.get(\"CI_width\", np.nan)) and summary[\"CI_width\"] <= ciw_max):\n","        return False\n","    if not any(np.isfinite(p) and p < p_thresh for p in pvals.values()):\n","        return False\n","    return True\n","\n","def phi_local_gate(summary, tol=0.05):\n","    med = summary.get(\"median\", np.nan)\n","    return bool(np.isfinite(med) and abs(med - PHI) <= tol)\n","\n","decisions = {}\n","for band in bands.keys():\n","    summary = band_summaries.get(band, {})\n","    pvals   = pvals_per_band.get(band, {})\n","    null_rejects = [k for k, p in pvals.items() if np.isfinite(p) and p < 0.01]\n","    decisions[band] = {\n","        \"structure?\": bool(structure_gate(summary, pvals)),\n","        \"φ-local?\": bool(phi_local_gate(summary, tol=0.05)),\n","        \"null_rejects\": null_rejects,\n","        \"breath_pass_global\": breath_pass,\n","    }\n","\n","# ---------- REGIME MAP TABLE ----------\n","regime_map_table = []\n","for band in bands.keys():\n","    regime_map_table.append({\n","        \"Band\": band,\n","        \"median\": band_summaries.get(band, {}).get(\"median\", np.nan),\n","        \"CI_width\": band_summaries.get(band, {}).get(\"CI_width\", np.nan),\n","        \"CV\": band_summaries.get(band, {}).get(\"CV\", np.nan),\n","        \"structure?\": \"Yes\" if decisions[band][\"structure?\"] else \"No\",\n","        \"φ-local?\": \"Yes\" if decisions[band][\"φ-local?\"] else \"No\",\n","        \"null_rejects\": \", \".join(decisions[band][\"null_rejects\"]),\n","    })\n","\n","# ---------- REPORT + EXPORT ----------\n","report = {\n","    \"Description\": \"δ̂_TV is the multiscale total-variation scaling exponent of the peak-centered, rank-normalized H3a signature windows, quantifying the roughness of their rank-order profile across coarse-graining scales.\",\n","    \"TensorSource\": name_used,\n","    \"DEMO_MODE\": bool(DEMO_MODE),\n","    \"PHI\": float(PHI),\n","    \"candidate_scales\": candidate_scales.tolist(),\n","    \"bands\": {k: v.tolist() for k, v in bands.items()},\n","    \"band_summaries\": band_summaries,\n","    \"null_phi_targeted\": {\n","        \"B_NULL\": int(B_NULL),\n","        \"summary_per_band\": null_summary_per_band,\n","        \"p_values_one_sided_per_band\": pvals_per_band,\n","        \"note\": \"p = P_null(|median_null - φ| ≤ |median_obs - φ|); lower → stronger evidence of nontrivial φ proximity\"\n","    },\n","    \"sensitivity_per_band\": sensitivity_per_band,\n","    \"breath_pass_global\": bool(breath_pass),\n","    \"decisions\": decisions,\n","    \"regime_map_table\": regime_map_table\n","}\n","\n","print(\"\\n==============================\")\n","print(\"REGIME MAP (copy/paste this)\")\n","print(\"==============================\")\n","for row in regime_map_table:\n","    print(row)\n","\n","with open(\"report.json\", \"w\") as f:\n","    json.dump(report, f, indent=2)\n","\n","print(\"\\nSaved: report.json\")\n","\n","report"]},{"cell_type":"markdown","metadata":{"id":"wySZUhDx-00K"},"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","\n","**Runtime → Run all.**\n","\n","This notebook:\n","1. Auto-detects your H3a rank-normalized signature window tensor if it exists in memory.\n","2. If not found, offers a one-click upload of a `.npy` or `.npz` tensor.\n","3. If neither is available, runs in clearly-labeled DEMO MODE.\n","\n","Outputs a **Regime Map table** plus a saved `report.json`.\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":108},"id":"IjGuY_ZS-00L","outputId":"2a3a2512-fb63-47b9-9ead-8c4ecfa41214"},"outputs":[{"name":"stdout","output_type":"stream","text":["No H3a tensor found in memory.\n","OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\n","OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\n"]},{"data":{"text/html":["\n","     <input type=\"file\" id=\"files-a3650acc-3e3e-4a92-8e70-1f28abbfd529\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-a3650acc-3e3e-4a92-8e70-1f28abbfd529\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "],"text/plain":["<IPython.core.display.HTML object>"]},"metadata":{},"output_type":"display_data"}],"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","# Runtime → Run all\n","#\n","# Purpose:\n","#   (1) Detect stable multiscale structure in H3a rank‑normalized signature windows\n","#   (2) Map where φ appears as a regime‑local attractor under null + perturbation controls\n","#\n","# What this notebook does NOT do:\n","#   - no mechanism claim\n","#   - no δ̂_TV → Hurst conversion claim\n","#   - no conflation with FUNt theoretical D≈1.2\n","#\n","# INPUT EXPECTATION:\n","#   A 2D tensor (n_windows, L), typically values in [0,1], e.g. (1278, 81).\n","#\n","# EASY BUTTON behavior:\n","#   A) If tensor already exists in memory under common upstream variable names, it auto‑uses it.\n","#   B) If not, it offers a one‑click upload of .npy or .npz (Colab).\n","#   C) If neither is available, it runs DEMO MODE (clearly labeled) so outputs appear.\n","\n","import numpy as np, os, json\n","\n","PHI = (1 + np.sqrt(5)) / 2\n","\n","# -------------------------\n","# 0) INPUT RESOLUTION (NO NAMEERROR)\n","# -------------------------\n","CANDIDATES = [\n","    \"H3a_windows_ranknorm\",\n","    \"windows_ranked_aligned\",\n","    \"signature_windows_final\",\n","    \"aligned_ranknorm_windows\",\n","    \"peak_centered_ranknorm\",\n","    \"W_normalized\",\n","    \"rank_windows_clean\",\n","]\n","\n","def _resolve_from_globals():\n","    g = globals()\n","    for name in CANDIDATES:\n","        if name in g:\n","            v = g[name]\n","            try:\n","                a = np.asarray(v, dtype=float)\n","                if a.ndim == 2 and a.shape[1] >= 16:\n","                    return name, a\n","            except Exception:\n","                pass\n","    return None, None\n","\n","name_used, signature_windows = _resolve_from_globals()\n","DEMO_MODE = False\n","\n","# Optional local path (if user wants to set it)\n","TENSOR_PATH = \"\"  # e.g., \"/content/H3a_windows_ranknorm.npy\" or \".npz\"\n","\n","if signature_windows is None and TENSOR_PATH and os.path.exists(TENSOR_PATH):\n","    if TENSOR_PATH.endswith(\".npy\"):\n","        signature_windows = np.load(TENSOR_PATH)\n","        name_used = f\"loaded:{TENSOR_PATH}\"\n","    elif TENSOR_PATH.endswith(\".npz\"):\n","        z = np.load(TENSOR_PATH)\n","        key = list(z.keys())[0]\n","        signature_windows = z[key]\n","        name_used = f\"loaded:{TENSOR_PATH}[{key}]\"\n","    else:\n","        raise ValueError(\"TENSOR_PATH must end in .npy or .npz\")\n","\n","# Colab upload helper (safe: user-controlled upload; no external calls)\n","if signature_windows is None:\n","    try:\n","        from google.colab import files\n","        print(\"No H3a tensor found in memory.\")\n","        print(\"OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\")\n","        print(\"OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\")\n","        up = files.upload()\n","        if up:\n","            fname = list(up.keys())[0]\n","            if fname.endswith(\".npy\"):\n","                signature_windows = np.load(fname)\n","                name_used = f\"uploaded:{fname}\"\n","            elif fname.endswith(\".npz\"):\n","                z = np.load(fname)\n","                key = list(z.keys())[0]\n","                signature_windows = z[key]\n","                name_used = f\"uploaded:{fname}[{key}]\"\n","            else:\n","                raise ValueError(\"Upload must be .npy or .npz containing the tensor.\")\n","    except Exception:\n","        pass\n","\n","# DEMO MODE fallback\n","if signature_windows is None:\n","    DEMO_MODE = True\n","    signature_windows = np.random.rand(400, 81)  # small-ish so it runs quickly anywhere\n","    name_used = \"DEMO_MODE_random_(400,81)\"\n","\n","W = np.asarray(signature_windows, dtype=float)\n","if W.ndim == 1:\n","    W = W[None, :]\n","n_windows, L = W.shape\n","\n","print(\"========================================\")\n","print(\"H3a δ̂_TV Regime Map — INPUT STATUS\")\n","print(\"========================================\")\n","print(\"Tensor source:\", name_used)\n","print(\"DEMO_MODE:\", DEMO_MODE)\n","print(\"Shape:\", W.shape)\n","print(\"Range:\", float(np.nanmin(W)), \"to\", float(np.nanmax(W)))\n","print(\"PHI:\", float(PHI))\n","assert L >= 16, \"Windows too short for multiscale slope fits.\"\n","\n","# -------------------------\n","# 1) REGIME MAP DIAGNOSTIC (OBSERVE‑ONLY)\n","# -------------------------\n","\n","# ---------- CORE ESTIMATOR: δ̂_TV ----------\n","def block_average(x, m):\n","    n = (len(x) // m) * m\n","    if n <= 0:\n","        return np.array([], dtype=float)\n","    return x[:n].reshape(-1, m).mean(axis=1)\n","\n","def total_variation(x):\n","    if len(x) < 2:\n","        return np.nan\n","    return float(np.sum(np.abs(np.diff(x))))\n","\n","def estimate_delta_TV(window, scales):\n","    eps_list, var_list = [], []\n","    for m in scales:\n","        y = block_average(window, int(m))\n","        v = total_variation(y)\n","        if np.isfinite(v) and v > 0 and len(y) >= 4:\n","            eps_list.append(float(m))\n","            var_list.append(float(v))\n","    if len(var_list) < 4:\n","        return np.nan\n","    log_eps = np.log(np.array(eps_list))\n","    log_var = np.log(np.array(var_list))\n","    slope, _ = np.polyfit(log_eps, log_var, 1)\n","    return float(-slope)\n","\n","# ---------- SCALE LADDER (min block size = 2) ----------\n","max_m = max(2, L // 4)\n","raw = np.logspace(np.log10(2), np.log10(max_m), num=10)\n","candidate_scales = np.unique(np.clip(np.round(raw), 2, max_m).astype(int))\n","candidate_scales = candidate_scales[candidate_scales >= 2]\n","print(\"candidate_scales:\", candidate_scales.tolist())\n","\n","# ---------- BAND SPLIT with MIN-SCALES GUARANTEE ----------\n","def make_bands(scales, min_scales=4):\n","    scales = np.asarray(scales, dtype=int)\n","    if len(scales) < (3 * min_scales):\n","        mid = int(np.median(scales))\n","        short = scales[scales <= mid]\n","        long  = scales[scales >= mid]\n","        return {\"short\": short, \"long\": long}\n","\n","    q1, q2 = np.quantile(scales, [1/3, 2/3])\n","    short = scales[scales <= q1]\n","    mid   = scales[(scales > q1) & (scales <= q2)]\n","    long  = scales[scales > q2]\n","\n","    bands = {\"short\": short, \"mid\": mid, \"long\": long}\n","\n","    if len(bands[\"mid\"]) < min_scales:\n","        if len(bands[\"short\"]) <= len(bands[\"long\"]):\n","            bands[\"short\"] = np.unique(np.concatenate([bands[\"short\"], bands[\"mid\"]]))\n","        else:\n","            bands[\"long\"]  = np.unique(np.concatenate([bands[\"mid\"], bands[\"long\"]]))\n","        del bands[\"mid\"]\n","\n","    for k in list(bands.keys()):\n","        if len(bands[k]) < min_scales:\n","            mid = int(np.median(scales))\n","            short = scales[scales <= mid]\n","            long  = scales[scales >= mid]\n","            return {\"short\": short, \"long\": long}\n","\n","    return bands\n","\n","bands = make_bands(candidate_scales, min_scales=4)\n","print(\"Bands:\", {k: v.tolist() for k, v in bands.items()})\n","\n","# ---------- SUMMARY / BOOTSTRAP ----------\n","def bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    n = len(x)\n","    if n < 5:\n","        return (np.nan, np.nan)\n","    rng = np.random.default_rng(seed)\n","    stats = np.empty(B, dtype=float)\n","    for b in range(B):\n","        stats[b] = np.median(x[rng.integers(0, n, size=n)])\n","    lo = float(np.quantile(stats, alpha/2))\n","    hi = float(np.quantile(stats, 1-alpha/2))\n","    return (lo, hi)\n","\n","def summarize(x):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    if len(x) == 0:\n","        return {}\n","    mean = float(np.mean(x))\n","    med  = float(np.median(x))\n","    sd   = float(np.std(x, ddof=1)) if len(x) > 1 else 0.0\n","    cv   = float(sd / mean) if mean != 0 else np.nan\n","    ci_lo, ci_hi = bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1)\n","    return {\n","        \"n\": int(len(x)),\n","        \"mean\": mean,\n","        \"median\": med,\n","        \"sd\": sd,\n","        \"CV\": cv,\n","        \"median_CI95\": (ci_lo, ci_hi),\n","        \"CI_width\": (ci_hi - ci_lo) if np.isfinite(ci_lo) and np.isfinite(ci_hi) else np.nan\n","    }\n","\n","# ---------- COMPUTE δ̂_TV PER BAND ----------\n","delta_per_band = {}\n","band_summaries = {}\n","for band, scales in bands.items():\n","    print(f\"Computing δ̂_TV band='{band}' scales={scales.tolist()} ...\")\n","    deltas = np.array([estimate_delta_TV(W[i], scales) for i in range(n_windows)], dtype=float)\n","    deltas = deltas[np.isfinite(deltas)]\n","    delta_per_band[band] = deltas\n","    band_summaries[band] = summarize(deltas)\n","\n","# ---------- NULLS (phi-targeted) ----------\n","def null_shuffle_ranks(w, rng):\n","    y = w.copy()\n","    rng.shuffle(y)\n","    return y\n","\n","def null_phase_randomize(w, rng):\n","    x = w - np.mean(w)\n","    X = np.fft.rfft(x)\n","    mag = np.abs(X)\n","    phase = np.angle(X)\n","    rand_phase = rng.uniform(-np.pi, np.pi, size=phase.shape)\n","    rand_phase[0] = phase[0]\n","    if len(rand_phase) > 1:\n","        rand_phase[-1] = phase[-1]\n","    Y = mag * np.exp(1j * rand_phase)\n","    return np.fft.irfft(Y, n=len(x))\n","\n","def null_random_monotone(L, rng):\n","    steps = np.abs(rng.normal(size=L))\n","    y = np.cumsum(steps)\n","    return (y - y.min()) / (y.max() - y.min() + 1e-12)\n","\n","def null_medians_for_band(kind, scales, B=200, seed=123, print_every=25):\n","    rng = np.random.default_rng(seed)\n","    meds = np.empty(B, dtype=float)\n","    for b in range(B):\n","        if (b % print_every) == 0:\n","            print(f\"[{kind}] {b}/{B}\")\n","        Dtmp = []\n","        for i in range(n_windows):\n","            w = W[i]\n","            if kind == \"shuffle\":\n","                w0 = null_shuffle_ranks(w, rng)\n","            elif kind == \"phase\":\n","                w0 = null_phase_randomize(w, rng)\n","            elif kind == \"monotone\":\n","                w0 = null_random_monotone(len(w), rng)\n","            else:\n","                raise ValueError(\"Unknown null kind.\")\n","            d = estimate_delta_TV(w0, scales)\n","            if np.isfinite(d):\n","                Dtmp.append(d)\n","        meds[b] = np.median(Dtmp) if len(Dtmp) else np.nan\n","    return meds[np.isfinite(meds)]\n","\n","null_kinds = [\"shuffle\", \"phase\", \"monotone\"]\n","B_NULL = 200 if not DEMO_MODE else 40  # demo runs faster\n","\n","pvals_per_band = {}\n","null_summary_per_band = {}\n","\n","for band, scales in bands.items():\n","    obs_med = band_summaries[band].get(\"median\", np.nan)\n","    if not np.isfinite(obs_med):\n","        continue\n","    print(f\"\\n=== Nulls: band '{band}' obs_median={obs_med:.6f} |obs-φ|={abs(obs_med-PHI):.6f} ===\")\n","    pvals, nsum = {}, {}\n","    for kind in null_kinds:\n","        nd = null_medians_for_band(kind, scales, B=B_NULL, seed=123, print_every=max(5, B_NULL//6))\n","        if len(nd) == 0:\n","            pvals[kind] = np.nan\n","            nsum[kind] = {}\n","            continue\n","        dev_obs = abs(obs_med - PHI)\n","        dev_null = np.abs(nd - PHI)\n","        p = float((np.sum(dev_null <= dev_obs) + 1) / (len(dev_null) + 1))\n","        pvals[kind] = p\n","        nsum[kind] = {\n","            \"n\": int(len(nd)),\n","            \"median\": float(np.median(nd)),\n","            \"CI95\": (float(np.quantile(nd, 0.025)), float(np.quantile(nd, 0.975))),\n","        }\n","        print(f\"  {kind:8s} null_median={nsum[kind]['median']:.6f}  p_phi={p:.6g}\")\n","    pvals_per_band[band] = pvals\n","    null_summary_per_band[band] = nsum\n","\n","# ---------- LIGHTWEIGHT PERTURBATION MEDIAN TRACKS ----------\n","def shift_window_edgepad(x, k):\n","    x = np.asarray(x)\n","    if k == 0:\n","        return x.copy()\n","    if k > 0:\n","        return np.concatenate([np.full(k, x[0]), x[:-k]])\n","    k2 = -k\n","    return np.concatenate([x[k2:], np.full(k2, x[-1])])\n","\n","noise_levels = [0.0, 0.05, 0.10]\n","jitter_shifts = [-3, -2, -1, 0, 1, 2, 3]\n","\n","sensitivity_per_band = {}\n","rng_sens = np.random.default_rng(999)\n","\n","for band, scales in bands.items():\n","    sens = {\"noise_median\": {}, \"jitter_median\": {}}\n","    for sigma in noise_levels:\n","        Wn = W + rng_sens.normal(0.0, sigma, size=W.shape)\n","        deltas = np.array([estimate_delta_TV(Wn[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"noise_median\"][sigma] = float(np.median(deltas)) if len(deltas) else np.nan\n","    for sh in jitter_shifts:\n","        Wj = np.vstack([shift_window_edgepad(W[i], sh) for i in range(n_windows)])\n","        deltas = np.array([estimate_delta_TV(Wj[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"jitter_median\"][sh] = float(np.median(deltas)) if len(deltas) else np.nan\n","    sensitivity_per_band[band] = sens\n","\n","# ---------- BREATH (bounded drift) ----------\n","def breath_pass_from_medians(medians, max_step=0.20):\n","    medians = np.asarray(medians, dtype=float)\n","    if not np.all(np.isfinite(medians)):\n","        return False\n","    steps = np.abs(np.diff(medians))\n","    return bool(np.all(steps <= max_step))\n","\n","band_order = list(bands.keys())\n","band_medians = [band_summaries[b].get(\"median\", np.nan) for b in band_order]\n","breath_pass = bool(breath_pass_from_medians(band_medians, max_step=0.20))\n","\n","# ---------- DECISIONS ----------\n","def structure_gate(summary, pvals, ciw_max=0.08, p_thresh=0.01):\n","    # NOTE: Structure gate intentionally does NOT enforce a strict CV cutoff.\n","    if not summary:\n","        return False\n","    if not (np.isfinite(summary.get(\"CI_width\", np.nan)) and summary[\"CI_width\"] <= ciw_max):\n","        return False\n","    if not any(np.isfinite(p) and p < p_thresh for p in pvals.values()):\n","        return False\n","    return True\n","\n","def phi_local_gate(summary, tol=0.05):\n","    med = summary.get(\"median\", np.nan)\n","    return bool(np.isfinite(med) and abs(med - PHI) <= tol)\n","\n","decisions = {}\n","for band in bands.keys():\n","    summary = band_summaries.get(band, {})\n","    pvals   = pvals_per_band.get(band, {})\n","    null_rejects = [k for k, p in pvals.items() if np.isfinite(p) and p < 0.01]\n","    decisions[band] = {\n","        \"structure?\": bool(structure_gate(summary, pvals)),\n","        \"φ-local?\": bool(phi_local_gate(summary, tol=0.05)),\n","        \"null_rejects\": null_rejects,\n","        \"breath_pass_global\": breath_pass,\n","    }\n","\n","# ---------- REGIME MAP TABLE ----------\n","regime_map_table = []\n","for band in bands.keys():\n","    regime_map_table.append({\n","        \"Band\": band,\n","        \"median\": band_summaries.get(band, {}).get(\"median\", np.nan),\n","        \"CI_width\": band_summaries.get(band, {}).get(\"CI_width\", np.nan),\n","        \"CV\": band_summaries.get(band, {}).get(\"CV\", np.nan),\n","        \"structure?\": \"Yes\" if decisions[band][\"structure?\"] else \"No\",\n","        \"φ-local?\": \"Yes\" if decisions[band][\"φ-local?\"] else \"No\",\n","        \"null_rejects\": \", \".join(decisions[band][\"null_rejects\"]),\n","    })\n","\n","# ---------- REPORT + EXPORT ----------\n","report = {\n","    \"Description\": \"δ̂_TV is the multiscale total-variation scaling exponent of the peak-centered, rank-normalized H3a signature windows, quantifying the roughness of their rank-order profile across coarse-graining scales.\",\n","    \"TensorSource\": name_used,\n","    \"DEMO_MODE\": bool(DEMO_MODE),\n","    \"PHI\": float(PHI),\n","    \"candidate_scales\": candidate_scales.tolist(),\n","    \"bands\": {k: v.tolist() for k, v in bands.items()},\n","    \"band_summaries\": band_summaries,\n","    \"null_phi_targeted\": {\n","        \"B_NULL\": int(B_NULL),\n","        \"summary_per_band\": null_summary_per_band,\n","        \"p_values_one_sided_per_band\": pvals_per_band,\n","        \"note\": \"p = P_null(|median_null - φ| ≤ |median_obs - φ|); lower → stronger evidence of nontrivial φ proximity\"\n","    },\n","    \"sensitivity_per_band\": sensitivity_per_band,\n","    \"breath_pass_global\": bool(breath_pass),\n","    \"decisions\": decisions,\n","    \"regime_map_table\": regime_map_table\n","}\n","\n","print(\"\\n==============================\")\n","print(\"REGIME MAP (copy/paste this)\")\n","print(\"==============================\")\n","for row in regime_map_table:\n","    print(row)\n","\n","with open(\"report.json\", \"w\") as f:\n","    json.dump(report, f, indent=2)\n","\n","print(\"\\nSaved: report.json\")\n","\n","report"]},{"cell_type":"markdown","metadata":{"id":"KEHw_A7HGL4w"},"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","\n","**Runtime → Run all.**\n","\n","This notebook:\n","1. Auto-detects your H3a rank-normalized signature window tensor if it exists in memory.\n","2. If not found, offers a one-click upload of a `.npy` or `.npz` tensor.\n","3. If neither is available, runs in clearly-labeled DEMO MODE.\n","\n","Outputs a **Regime Map table** plus a saved `report.json`.\n"]},{"cell_type":"code","execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"outputId":"182c0549-d142-47e0-8b6f-20f08500360e","id":"txSLk56JGL4x","executionInfo":{"status":"ok","timestamp":1766877403924,"user_tz":300,"elapsed":40181,"user":{"displayName":"Michael Nowlin","userId":"15939787152312273307"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["No H3a tensor found in memory.\n","OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\n","OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-2332a21b-122c-4d6a-866f-aec57c137a0f\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-2332a21b-122c-4d6a-866f-aec57c137a0f\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["========================================\n","H3a δ̂_TV Regime Map — INPUT STATUS\n","========================================\n","Tensor source: DEMO_MODE_random_(400,81)\n","DEMO_MODE: True\n","Shape: (400, 81)\n","Range: 1.3128684045016215e-05 to 0.9999991118136444\n","PHI: 1.618033988749895\n","candidate_scales: [2, 3, 4, 6, 7, 9, 12, 15, 20]\n","Bands: {'short': [2, 3, 4, 6, 7], 'long': [7, 9, 12, 15, 20]}\n","Computing δ̂_TV band='short' scales=[2, 3, 4, 6, 7] ...\n","Computing δ̂_TV band='long' scales=[7, 9, 12, 15, 20] ...\n","\n","=== Nulls: band 'short' obs_median=1.604968 |obs-φ|=0.013066 ===\n","[shuffle] 0/40\n","[shuffle] 6/40\n","[shuffle] 12/40\n","[shuffle] 18/40\n","[shuffle] 24/40\n","[shuffle] 30/40\n","[shuffle] 36/40\n","  shuffle  null_median=1.612220  p_phi=0.634146\n","[phase] 0/40\n","[phase] 6/40\n","[phase] 12/40\n","[phase] 18/40\n","[phase] 24/40\n","[phase] 30/40\n","[phase] 36/40\n","  phase    null_median=1.602463  p_phi=0.390244\n","[monotone] 0/40\n","[monotone] 6/40\n","[monotone] 12/40\n","[monotone] 18/40\n","[monotone] 24/40\n","[monotone] 30/40\n","[monotone] 36/40\n","  monotone null_median=0.089151  p_phi=0.0243902\n","\n","=== Nulls: band 'long' obs_median=1.771462 |obs-φ|=0.153428 ===\n","[shuffle] 0/40\n","[shuffle] 6/40\n","[shuffle] 12/40\n","[shuffle] 18/40\n","[shuffle] 24/40\n","[shuffle] 30/40\n","[shuffle] 36/40\n","  shuffle  null_median=1.743521  p_phi=0.829268\n","[phase] 0/40\n","[phase] 6/40\n","[phase] 12/40\n","[phase] 18/40\n","[phase] 24/40\n","[phase] 30/40\n","[phase] 36/40\n","  phase    null_median=1.747896  p_phi=0.804878\n","[monotone] 0/40\n","[monotone] 6/40\n","[monotone] 12/40\n","[monotone] 18/40\n","[monotone] 24/40\n","[monotone] 30/40\n","[monotone] 36/40\n","  monotone null_median=0.189581  p_phi=0.0243902\n","\n","==============================\n","REGIME MAP (copy/paste this)\n","==============================\n","{'Band': 'short', 'median': 1.6049681061634908, 'CI_width': 0.05584392101015312, 'CV': 0.15576600830674284, 'structure?': 'No', 'φ-local?': 'Yes', 'null_rejects': ''}\n","{'Band': 'long', 'median': 1.7714616216370784, 'CI_width': 0.12843349504368917, 'CV': 0.3014593647827778, 'structure?': 'No', 'φ-local?': 'No', 'null_rejects': ''}\n","\n","Saved: report.json\n"]},{"output_type":"execute_result","data":{"text/plain":["{'Description': 'δ̂_TV is the multiscale total-variation scaling exponent of the peak-centered, rank-normalized H3a signature windows, quantifying the roughness of their rank-order profile across coarse-graining scales.',\n"," 'TensorSource': 'DEMO_MODE_random_(400,81)',\n"," 'DEMO_MODE': True,\n"," 'PHI': 1.618033988749895,\n"," 'candidate_scales': [2, 3, 4, 6, 7, 9, 12, 15, 20],\n"," 'bands': {'short': [2, 3, 4, 6, 7], 'long': [7, 9, 12, 15, 20]},\n"," 'band_summaries': {'short': {'n': 400,\n","   'mean': 1.6107874667057418,\n","   'median': 1.6049681061634908,\n","   'sd': 0.25090593391928384,\n","   'CV': 0.15576600830674284,\n","   'median_CI95': (1.5760411222047657, 1.6318850432149188),\n","   'CI_width': 0.05584392101015312},\n","  'long': {'n': 400,\n","   'mean': 1.7895381293456467,\n","   'median': 1.7714616216370784,\n","   'sd': 0.5394730277270992,\n","   'CV': 0.3014593647827778,\n","   'median_CI95': (1.708907511724086, 1.8373410067677751),\n","   'CI_width': 0.12843349504368917}},\n"," 'null_phi_targeted': {'B_NULL': 40,\n","  'summary_per_band': {'short': {'shuffle': {'n': 40,\n","     'median': 1.6122199561661565,\n","     'CI95': (1.5903072349885434, 1.6336692379406073)},\n","    'phase': {'n': 40,\n","     'median': 1.6024628672102859,\n","     'CI95': (1.5915460459237722, 1.622278437237782)},\n","    'monotone': {'n': 40,\n","     'median': 0.08915075239314962,\n","     'CI95': (0.08698438425778296, 0.09075959528464599)}},\n","   'long': {'shuffle': {'n': 40,\n","     'median': 1.743520590190537,\n","     'CI95': (1.702690126206603, 1.7925275093662851)},\n","    'phase': {'n': 40,\n","     'median': 1.7478958313451338,\n","     'CI95': (1.7050875997332882, 1.8000992313252964)},\n","    'monotone': {'n': 40,\n","     'median': 0.18958095632509472,\n","     'CI95': (0.18667634219847193, 0.19183892383012927)}}},\n","  'p_values_one_sided_per_band': {'short': {'shuffle': 0.6341463414634146,\n","    'phase': 0.3902439024390244,\n","    'monotone': 0.024390243902439025},\n","   'long': {'shuffle': 0.8292682926829268,\n","    'phase': 0.8048780487804879,\n","    'monotone': 0.024390243902439025}},\n","  'note': 'p = P_null(|median_null - φ| ≤ |median_obs - φ|); lower → stronger evidence of nontrivial φ proximity'},\n"," 'sensitivity_per_band': {'short': {'noise_median': {0.0: 1.6049681061634908,\n","    0.05: 1.60027156672711,\n","    0.1: 1.5781433592708156},\n","   'jitter_median': {-3: 1.5963790454216131,\n","    -2: 1.6195548562245838,\n","    -1: 1.5963422076472815,\n","    0: 1.6049681061634908,\n","    1: 1.6201532353614128,\n","    2: 1.5777939107295422,\n","    3: 1.5636635135801165}},\n","  'long': {'noise_median': {0.0: 1.7714616216370784,\n","    0.05: 1.7724876315011533,\n","    0.1: 1.7741194754794238},\n","   'jitter_median': {-3: 1.7793174712509399,\n","    -2: 1.7323223617490806,\n","    -1: 1.803530841872886,\n","    0: 1.7714616216370784,\n","    1: 1.7589084884996171,\n","    2: 1.7644967348333154,\n","    3: 1.7406243365960679}}},\n"," 'breath_pass_global': True,\n"," 'decisions': {'short': {'structure?': False,\n","   'φ-local?': True,\n","   'null_rejects': [],\n","   'breath_pass_global': True},\n","  'long': {'structure?': False,\n","   'φ-local?': False,\n","   'null_rejects': [],\n","   'breath_pass_global': True}},\n"," 'regime_map_table': [{'Band': 'short',\n","   'median': 1.6049681061634908,\n","   'CI_width': 0.05584392101015312,\n","   'CV': 0.15576600830674284,\n","   'structure?': 'No',\n","   'φ-local?': 'Yes',\n","   'null_rejects': ''},\n","  {'Band': 'long',\n","   'median': 1.7714616216370784,\n","   'CI_width': 0.12843349504368917,\n","   'CV': 0.3014593647827778,\n","   'structure?': 'No',\n","   'φ-local?': 'No',\n","   'null_rejects': ''}]}"]},"metadata":{},"execution_count":2}],"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","# Runtime → Run all\n","#\n","# Purpose:\n","#   (1) Detect stable multiscale structure in H3a rank‑normalized signature windows\n","#   (2) Map where φ appears as a regime‑local attractor under null + perturbation controls\n","#\n","# What this notebook does NOT do:\n","#   - no mechanism claim\n","#   - no δ̂_TV → Hurst conversion claim\n","#   - no conflation with FUNt theoretical D≈1.2\n","#\n","# INPUT EXPECTATION:\n","#   A 2D tensor (n_windows, L), typically values in [0,1], e.g. (1278, 81).\n","#\n","# EASY BUTTON behavior:\n","#   A) If tensor already exists in memory under common upstream variable names, it auto‑uses it.\n","#   B) If not, it offers a one‑click upload of .npy or .npz (Colab).\n","#   C) If neither is available, it runs DEMO MODE (clearly labeled) so outputs appear.\n","\n","import numpy as np, os, json\n","\n","PHI = (1 + np.sqrt(5)) / 2\n","\n","# -------------------------\n","# 0) INPUT RESOLUTION (NO NAMEERROR)\n","# -------------------------\n","CANDIDATES = [\n","    \"H3a_windows_ranknorm\",\n","    \"windows_ranked_aligned\",\n","    \"signature_windows_final\",\n","    \"aligned_ranknorm_windows\",\n","    \"peak_centered_ranknorm\",\n","    \"W_normalized\",\n","    \"rank_windows_clean\",\n","]\n","\n","def _resolve_from_globals():\n","    g = globals()\n","    for name in CANDIDATES:\n","        if name in g:\n","            v = g[name]\n","            try:\n","                a = np.asarray(v, dtype=float)\n","                if a.ndim == 2 and a.shape[1] >= 16:\n","                    return name, a\n","            except Exception:\n","                pass\n","    return None, None\n","\n","name_used, signature_windows = _resolve_from_globals()\n","DEMO_MODE = False\n","\n","# Optional local path (if user wants to set it)\n","TENSOR_PATH = \"\"  # e.g., \"/content/H3a_windows_ranknorm.npy\" or \".npz\"\n","\n","if signature_windows is None and TENSOR_PATH and os.path.exists(TENSOR_PATH):\n","    if TENSOR_PATH.endswith(\".npy\"):\n","        signature_windows = np.load(TENSOR_PATH)\n","        name_used = f\"loaded:{TENSOR_PATH}\"\n","    elif TENSOR_PATH.endswith(\".npz\"):\n","        z = np.load(TENSOR_PATH)\n","        key = list(z.keys())[0]\n","        signature_windows = z[key]\n","        name_used = f\"loaded:{TENSOR_PATH}[{key}]\"\n","    else:\n","        raise ValueError(\"TENSOR_PATH must end in .npy or .npz\")\n","\n","# Colab upload helper (safe: user-controlled upload; no external calls)\n","if signature_windows is None:\n","    try:\n","        from google.colab import files\n","        print(\"No H3a tensor found in memory.\")\n","        print(\"OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\")\n","        print(\"OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\")\n","        up = files.upload()\n","        if up:\n","            fname = list(up.keys())[0]\n","            if fname.endswith(\".npy\"):\n","                signature_windows = np.load(fname)\n","                name_used = f\"uploaded:{fname}\"\n","            elif fname.endswith(\".npz\"):\n","                z = np.load(fname)\n","                key = list(z.keys())[0]\n","                signature_windows = z[key]\n","                name_used = f\"uploaded:{fname}[{key}]\"\n","            else:\n","                raise ValueError(\"Upload must be .npy or .npz containing the tensor.\")\n","    except Exception:\n","        pass\n","\n","# DEMO MODE fallback\n","if signature_windows is None:\n","    DEMO_MODE = True\n","    signature_windows = np.random.rand(400, 81)  # small-ish so it runs quickly anywhere\n","    name_used = \"DEMO_MODE_random_(400,81)\"\n","\n","W = np.asarray(signature_windows, dtype=float)\n","if W.ndim == 1:\n","    W = W[None, :]\n","n_windows, L = W.shape\n","\n","print(\"========================================\")\n","print(\"H3a δ̂_TV Regime Map — INPUT STATUS\")\n","print(\"========================================\")\n","print(\"Tensor source:\", name_used)\n","print(\"DEMO_MODE:\", DEMO_MODE)\n","print(\"Shape:\", W.shape)\n","print(\"Range:\", float(np.nanmin(W)), \"to\", float(np.nanmax(W)))\n","print(\"PHI:\", float(PHI))\n","assert L >= 16, \"Windows too short for multiscale slope fits.\"\n","\n","# -------------------------\n","# 1) REGIME MAP DIAGNOSTIC (OBSERVE‑ONLY)\n","# -------------------------\n","\n","# ---------- CORE ESTIMATOR: δ̂_TV ----------\n","def block_average(x, m):\n","    n = (len(x) // m) * m\n","    if n <= 0:\n","        return np.array([], dtype=float)\n","    return x[:n].reshape(-1, m).mean(axis=1)\n","\n","def total_variation(x):\n","    if len(x) < 2:\n","        return np.nan\n","    return float(np.sum(np.abs(np.diff(x))))\n","\n","def estimate_delta_TV(window, scales):\n","    eps_list, var_list = [], []\n","    for m in scales:\n","        y = block_average(window, int(m))\n","        v = total_variation(y)\n","        if np.isfinite(v) and v > 0 and len(y) >= 4:\n","            eps_list.append(float(m))\n","            var_list.append(float(v))\n","    if len(var_list) < 4:\n","        return np.nan\n","    log_eps = np.log(np.array(eps_list))\n","    log_var = np.log(np.array(var_list))\n","    slope, _ = np.polyfit(log_eps, log_var, 1)\n","    return float(-slope)\n","\n","# ---------- SCALE LADDER (min block size = 2) ----------\n","max_m = max(2, L // 4)\n","raw = np.logspace(np.log10(2), np.log10(max_m), num=10)\n","candidate_scales = np.unique(np.clip(np.round(raw), 2, max_m).astype(int))\n","candidate_scales = candidate_scales[candidate_scales >= 2]\n","print(\"candidate_scales:\", candidate_scales.tolist())\n","\n","# ---------- BAND SPLIT with MIN-SCALES GUARANTEE ----------\n","def make_bands(scales, min_scales=4):\n","    scales = np.asarray(scales, dtype=int)\n","    if len(scales) < (3 * min_scales):\n","        mid = int(np.median(scales))\n","        short = scales[scales <= mid]\n","        long  = scales[scales >= mid]\n","        return {\"short\": short, \"long\": long}\n","\n","    q1, q2 = np.quantile(scales, [1/3, 2/3])\n","    short = scales[scales <= q1]\n","    mid   = scales[(scales > q1) & (scales <= q2)]\n","    long  = scales[scales > q2]\n","\n","    bands = {\"short\": short, \"mid\": mid, \"long\": long}\n","\n","    if len(bands[\"mid\"]) < min_scales:\n","        if len(bands[\"short\"]) <= len(bands[\"long\"]):\n","            bands[\"short\"] = np.unique(np.concatenate([bands[\"short\"], bands[\"mid\"]]))\n","        else:\n","            bands[\"long\"]  = np.unique(np.concatenate([bands[\"mid\"], bands[\"long\"]]))\n","        del bands[\"mid\"]\n","\n","    for k in list(bands.keys()):\n","        if len(bands[k]) < min_scales:\n","            mid = int(np.median(scales))\n","            short = scales[scales <= mid]\n","            long  = scales[scales >= mid]\n","            return {\"short\": short, \"long\": long}\n","\n","    return bands\n","\n","bands = make_bands(candidate_scales, min_scales=4)\n","print(\"Bands:\", {k: v.tolist() for k, v in bands.items()})\n","\n","# ---------- SUMMARY / BOOTSTRAP ----------\n","def bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    n = len(x)\n","    if n < 5:\n","        return (np.nan, np.nan)\n","    rng = np.random.default_rng(seed)\n","    stats = np.empty(B, dtype=float)\n","    for b in range(B):\n","        stats[b] = np.median(x[rng.integers(0, n, size=n)])\n","    lo = float(np.quantile(stats, alpha/2))\n","    hi = float(np.quantile(stats, 1-alpha/2))\n","    return (lo, hi)\n","\n","def summarize(x):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    if len(x) == 0:\n","        return {}\n","    mean = float(np.mean(x))\n","    med  = float(np.median(x))\n","    sd   = float(np.std(x, ddof=1)) if len(x) > 1 else 0.0\n","    cv   = float(sd / mean) if mean != 0 else np.nan\n","    ci_lo, ci_hi = bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1)\n","    return {\n","        \"n\": int(len(x)),\n","        \"mean\": mean,\n","        \"median\": med,\n","        \"sd\": sd,\n","        \"CV\": cv,\n","        \"median_CI95\": (ci_lo, ci_hi),\n","        \"CI_width\": (ci_hi - ci_lo) if np.isfinite(ci_lo) and np.isfinite(ci_hi) else np.nan\n","    }\n","\n","# ---------- COMPUTE δ̂_TV PER BAND ----------\n","delta_per_band = {}\n","band_summaries = {}\n","for band, scales in bands.items():\n","    print(f\"Computing δ̂_TV band='{band}' scales={scales.tolist()} ...\")\n","    deltas = np.array([estimate_delta_TV(W[i], scales) for i in range(n_windows)], dtype=float)\n","    deltas = deltas[np.isfinite(deltas)]\n","    delta_per_band[band] = deltas\n","    band_summaries[band] = summarize(deltas)\n","\n","# ---------- NULLS (phi-targeted) ----------\n","def null_shuffle_ranks(w, rng):\n","    y = w.copy()\n","    rng.shuffle(y)\n","    return y\n","\n","def null_phase_randomize(w, rng):\n","    x = w - np.mean(w)\n","    X = np.fft.rfft(x)\n","    mag = np.abs(X)\n","    phase = np.angle(X)\n","    rand_phase = rng.uniform(-np.pi, np.pi, size=phase.shape)\n","    rand_phase[0] = phase[0]\n","    if len(rand_phase) > 1:\n","        rand_phase[-1] = phase[-1]\n","    Y = mag * np.exp(1j * rand_phase)\n","    return np.fft.irfft(Y, n=len(x))\n","\n","def null_random_monotone(L, rng):\n","    steps = np.abs(rng.normal(size=L))\n","    y = np.cumsum(steps)\n","    return (y - y.min()) / (y.max() - y.min() + 1e-12)\n","\n","def null_medians_for_band(kind, scales, B=200, seed=123, print_every=25):\n","    rng = np.random.default_rng(seed)\n","    meds = np.empty(B, dtype=float)\n","    for b in range(B):\n","        if (b % print_every) == 0:\n","            print(f\"[{kind}] {b}/{B}\")\n","        Dtmp = []\n","        for i in range(n_windows):\n","            w = W[i]\n","            if kind == \"shuffle\":\n","                w0 = null_shuffle_ranks(w, rng)\n","            elif kind == \"phase\":\n","                w0 = null_phase_randomize(w, rng)\n","            elif kind == \"monotone\":\n","                w0 = null_random_monotone(len(w), rng)\n","            else:\n","                raise ValueError(\"Unknown null kind.\")\n","            d = estimate_delta_TV(w0, scales)\n","            if np.isfinite(d):\n","                Dtmp.append(d)\n","        meds[b] = np.median(Dtmp) if len(Dtmp) else np.nan\n","    return meds[np.isfinite(meds)]\n","\n","null_kinds = [\"shuffle\", \"phase\", \"monotone\"]\n","B_NULL = 200 if not DEMO_MODE else 40  # demo runs faster\n","\n","pvals_per_band = {}\n","null_summary_per_band = {}\n","\n","for band, scales in bands.items():\n","    obs_med = band_summaries[band].get(\"median\", np.nan)\n","    if not np.isfinite(obs_med):\n","        continue\n","    print(f\"\\n=== Nulls: band '{band}' obs_median={obs_med:.6f} |obs-φ|={abs(obs_med-PHI):.6f} ===\")\n","    pvals, nsum = {}, {}\n","    for kind in null_kinds:\n","        nd = null_medians_for_band(kind, scales, B=B_NULL, seed=123, print_every=max(5, B_NULL//6))\n","        if len(nd) == 0:\n","            pvals[kind] = np.nan\n","            nsum[kind] = {}\n","            continue\n","        dev_obs = abs(obs_med - PHI)\n","        dev_null = np.abs(nd - PHI)\n","        p = float((np.sum(dev_null <= dev_obs) + 1) / (len(dev_null) + 1))\n","        pvals[kind] = p\n","        nsum[kind] = {\n","            \"n\": int(len(nd)),\n","            \"median\": float(np.median(nd)),\n","            \"CI95\": (float(np.quantile(nd, 0.025)), float(np.quantile(nd, 0.975))),\n","        }\n","        print(f\"  {kind:8s} null_median={nsum[kind]['median']:.6f}  p_phi={p:.6g}\")\n","    pvals_per_band[band] = pvals\n","    null_summary_per_band[band] = nsum\n","\n","# ---------- LIGHTWEIGHT PERTURBATION MEDIAN TRACKS ----------\n","def shift_window_edgepad(x, k):\n","    x = np.asarray(x)\n","    if k == 0:\n","        return x.copy()\n","    if k > 0:\n","        return np.concatenate([np.full(k, x[0]), x[:-k]])\n","    k2 = -k\n","    return np.concatenate([x[k2:], np.full(k2, x[-1])])\n","\n","noise_levels = [0.0, 0.05, 0.10]\n","jitter_shifts = [-3, -2, -1, 0, 1, 2, 3]\n","\n","sensitivity_per_band = {}\n","rng_sens = np.random.default_rng(999)\n","\n","for band, scales in bands.items():\n","    sens = {\"noise_median\": {}, \"jitter_median\": {}}\n","    for sigma in noise_levels:\n","        Wn = W + rng_sens.normal(0.0, sigma, size=W.shape)\n","        deltas = np.array([estimate_delta_TV(Wn[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"noise_median\"][sigma] = float(np.median(deltas)) if len(deltas) else np.nan\n","    for sh in jitter_shifts:\n","        Wj = np.vstack([shift_window_edgepad(W[i], sh) for i in range(n_windows)])\n","        deltas = np.array([estimate_delta_TV(Wj[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"jitter_median\"][sh] = float(np.median(deltas)) if len(deltas) else np.nan\n","    sensitivity_per_band[band] = sens\n","\n","# ---------- BREATH (bounded drift) ----------\n","def breath_pass_from_medians(medians, max_step=0.20):\n","    medians = np.asarray(medians, dtype=float)\n","    if not np.all(np.isfinite(medians)):\n","        return False\n","    steps = np.abs(np.diff(medians))\n","    return bool(np.all(steps <= max_step))\n","\n","band_order = list(bands.keys())\n","band_medians = [band_summaries[b].get(\"median\", np.nan) for b in band_order]\n","breath_pass = bool(breath_pass_from_medians(band_medians, max_step=0.20))\n","\n","# ---------- DECISIONS ----------\n","def structure_gate(summary, pvals, ciw_max=0.08, p_thresh=0.01):\n","    # NOTE: Structure gate intentionally does NOT enforce a strict CV cutoff.\n","    if not summary:\n","        return False\n","    if not (np.isfinite(summary.get(\"CI_width\", np.nan)) and summary[\"CI_width\"] <= ciw_max):\n","        return False\n","    if not any(np.isfinite(p) and p < p_thresh for p in pvals.values()):\n","        return False\n","    return True\n","\n","def phi_local_gate(summary, tol=0.05):\n","    med = summary.get(\"median\", np.nan)\n","    return bool(np.isfinite(med) and abs(med - PHI) <= tol)\n","\n","decisions = {}\n","for band in bands.keys():\n","    summary = band_summaries.get(band, {})\n","    pvals   = pvals_per_band.get(band, {})\n","    null_rejects = [k for k, p in pvals.items() if np.isfinite(p) and p < 0.01]\n","    decisions[band] = {\n","        \"structure?\": bool(structure_gate(summary, pvals)),\n","        \"φ-local?\": bool(phi_local_gate(summary, tol=0.05)),\n","        \"null_rejects\": null_rejects,\n","        \"breath_pass_global\": breath_pass,\n","    }\n","\n","# ---------- REGIME MAP TABLE ----------\n","regime_map_table = []\n","for band in bands.keys():\n","    regime_map_table.append({\n","        \"Band\": band,\n","        \"median\": band_summaries.get(band, {}).get(\"median\", np.nan),\n","        \"CI_width\": band_summaries.get(band, {}).get(\"CI_width\", np.nan),\n","        \"CV\": band_summaries.get(band, {}).get(\"CV\", np.nan),\n","        \"structure?\": \"Yes\" if decisions[band][\"structure?\"] else \"No\",\n","        \"φ-local?\": \"Yes\" if decisions[band][\"φ-local?\"] else \"No\",\n","        \"null_rejects\": \", \".join(decisions[band][\"null_rejects\"]),\n","    })\n","\n","# ---------- REPORT + EXPORT ----------\n","report = {\n","    \"Description\": \"δ̂_TV is the multiscale total-variation scaling exponent of the peak-centered, rank-normalized H3a signature windows, quantifying the roughness of their rank-order profile across coarse-graining scales.\",\n","    \"TensorSource\": name_used,\n","    \"DEMO_MODE\": bool(DEMO_MODE),\n","    \"PHI\": float(PHI),\n","    \"candidate_scales\": candidate_scales.tolist(),\n","    \"bands\": {k: v.tolist() for k, v in bands.items()},\n","    \"band_summaries\": band_summaries,\n","    \"null_phi_targeted\": {\n","        \"B_NULL\": int(B_NULL),\n","        \"summary_per_band\": null_summary_per_band,\n","        \"p_values_one_sided_per_band\": pvals_per_band,\n","        \"note\": \"p = P_null(|median_null - φ| ≤ |median_obs - φ|); lower → stronger evidence of nontrivial φ proximity\"\n","    },\n","    \"sensitivity_per_band\": sensitivity_per_band,\n","    \"breath_pass_global\": bool(breath_pass),\n","    \"decisions\": decisions,\n","    \"regime_map_table\": regime_map_table\n","}\n","\n","print(\"\\n==============================\")\n","print(\"REGIME MAP (copy/paste this)\")\n","print(\"==============================\")\n","for row in regime_map_table:\n","    print(row)\n","\n","with open(\"report.json\", \"w\") as f:\n","    json.dump(report, f, indent=2)\n","\n","print(\"\\nSaved: report.json\")\n","\n","report"]},{"cell_type":"markdown","metadata":{"id":"XX-XqAM_G4fF"},"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","\n","**Runtime → Run all.**\n","\n","This notebook:\n","1. Auto-detects your H3a rank-normalized signature window tensor if it exists in memory.\n","2. If not found, offers a one-click upload of a `.npy` or `.npz` tensor.\n","3. If neither is available, runs in clearly-labeled DEMO MODE.\n","\n","Outputs a **Regime Map table** plus a saved `report.json`.\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":108},"outputId":"2a3a2512-fb63-47b9-9ead-8c4ecfa41214","id":"d4i1k06sG4fG"},"outputs":[{"name":"stdout","output_type":"stream","text":["No H3a tensor found in memory.\n","OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\n","OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\n"]},{"data":{"text/html":["\n","     <input type=\"file\" id=\"files-a3650acc-3e3e-4a92-8e70-1f28abbfd529\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-a3650acc-3e3e-4a92-8e70-1f28abbfd529\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "],"text/plain":["<IPython.core.display.HTML object>"]},"metadata":{},"output_type":"display_data"}],"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","# Runtime → Run all\n","#\n","# Purpose:\n","#   (1) Detect stable multiscale structure in H3a rank‑normalized signature windows\n","#   (2) Map where φ appears as a regime‑local attractor under null + perturbation controls\n","#\n","# What this notebook does NOT do:\n","#   - no mechanism claim\n","#   - no δ̂_TV → Hurst conversion claim\n","#   - no conflation with FUNt theoretical D≈1.2\n","#\n","# INPUT EXPECTATION:\n","#   A 2D tensor (n_windows, L), typically values in [0,1], e.g. (1278, 81).\n","#\n","# EASY BUTTON behavior:\n","#   A) If tensor already exists in memory under common upstream variable names, it auto‑uses it.\n","#   B) If not, it offers a one‑click upload of .npy or .npz (Colab).\n","#   C) If neither is available, it runs DEMO MODE (clearly labeled) so outputs appear.\n","\n","import numpy as np, os, json\n","\n","PHI = (1 + np.sqrt(5)) / 2\n","\n","# -------------------------\n","# 0) INPUT RESOLUTION (NO NAMEERROR)\n","# -------------------------\n","CANDIDATES = [\n","    \"H3a_windows_ranknorm\",\n","    \"windows_ranked_aligned\",\n","    \"signature_windows_final\",\n","    \"aligned_ranknorm_windows\",\n","    \"peak_centered_ranknorm\",\n","    \"W_normalized\",\n","    \"rank_windows_clean\",\n","]\n","\n","def _resolve_from_globals():\n","    g = globals()\n","    for name in CANDIDATES:\n","        if name in g:\n","            v = g[name]\n","            try:\n","                a = np.asarray(v, dtype=float)\n","                if a.ndim == 2 and a.shape[1] >= 16:\n","                    return name, a\n","            except Exception:\n","                pass\n","    return None, None\n","\n","name_used, signature_windows = _resolve_from_globals()\n","DEMO_MODE = False\n","\n","# Optional local path (if user wants to set it)\n","TENSOR_PATH = \"\"  # e.g., \"/content/H3a_windows_ranknorm.npy\" or \".npz\"\n","\n","if signature_windows is None and TENSOR_PATH and os.path.exists(TENSOR_PATH):\n","    if TENSOR_PATH.endswith(\".npy\"):\n","        signature_windows = np.load(TENSOR_PATH)\n","        name_used = f\"loaded:{TENSOR_PATH}\"\n","    elif TENSOR_PATH.endswith(\".npz\"):\n","        z = np.load(TENSOR_PATH)\n","        key = list(z.keys())[0]\n","        signature_windows = z[key]\n","        name_used = f\"loaded:{TENSOR_PATH}[{key}]\"\n","    else:\n","        raise ValueError(\"TENSOR_PATH must end in .npy or .npz\")\n","\n","# Colab upload helper (safe: user-controlled upload; no external calls)\n","if signature_windows is None:\n","    try:\n","        from google.colab import files\n","        print(\"No H3a tensor found in memory.\")\n","        print(\"OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\")\n","        print(\"OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\")\n","        up = files.upload()\n","        if up:\n","            fname = list(up.keys())[0]\n","            if fname.endswith(\".npy\"):\n","                signature_windows = np.load(fname)\n","                name_used = f\"uploaded:{fname}\"\n","            elif fname.endswith(\".npz\"):\n","                z = np.load(fname)\n","                key = list(z.keys())[0]\n","                signature_windows = z[key]\n","                name_used = f\"uploaded:{fname}[{key}]\"\n","            else:\n","                raise ValueError(\"Upload must be .npy or .npz containing the tensor.\")\n","    except Exception:\n","        pass\n","\n","# DEMO MODE fallback\n","if signature_windows is None:\n","    DEMO_MODE = True\n","    signature_windows = np.random.rand(400, 81)  # small-ish so it runs quickly anywhere\n","    name_used = \"DEMO_MODE_random_(400,81)\"\n","\n","W = np.asarray(signature_windows, dtype=float)\n","if W.ndim == 1:\n","    W = W[None, :]\n","n_windows, L = W.shape\n","\n","print(\"========================================\")\n","print(\"H3a δ̂_TV Regime Map — INPUT STATUS\")\n","print(\"========================================\")\n","print(\"Tensor source:\", name_used)\n","print(\"DEMO_MODE:\", DEMO_MODE)\n","print(\"Shape:\", W.shape)\n","print(\"Range:\", float(np.nanmin(W)), \"to\", float(np.nanmax(W)))\n","print(\"PHI:\", float(PHI))\n","assert L >= 16, \"Windows too short for multiscale slope fits.\"\n","\n","# -------------------------\n","# 1) REGIME MAP DIAGNOSTIC (OBSERVE‑ONLY)\n","# -------------------------\n","\n","# ---------- CORE ESTIMATOR: δ̂_TV ----------\n","def block_average(x, m):\n","    n = (len(x) // m) * m\n","    if n <= 0:\n","        return np.array([], dtype=float)\n","    return x[:n].reshape(-1, m).mean(axis=1)\n","\n","def total_variation(x):\n","    if len(x) < 2:\n","        return np.nan\n","    return float(np.sum(np.abs(np.diff(x))))\n","\n","def estimate_delta_TV(window, scales):\n","    eps_list, var_list = [], []\n","    for m in scales:\n","        y = block_average(window, int(m))\n","        v = total_variation(y)\n","        if np.isfinite(v) and v > 0 and len(y) >= 4:\n","            eps_list.append(float(m))\n","            var_list.append(float(v))\n","    if len(var_list) < 4:\n","        return np.nan\n","    log_eps = np.log(np.array(eps_list))\n","    log_var = np.log(np.array(var_list))\n","    slope, _ = np.polyfit(log_eps, log_var, 1)\n","    return float(-slope)\n","\n","# ---------- SCALE LADDER (min block size = 2) ----------\n","max_m = max(2, L // 4)\n","raw = np.logspace(np.log10(2), np.log10(max_m), num=10)\n","candidate_scales = np.unique(np.clip(np.round(raw), 2, max_m).astype(int))\n","candidate_scales = candidate_scales[candidate_scales >= 2]\n","print(\"candidate_scales:\", candidate_scales.tolist())\n","\n","# ---------- BAND SPLIT with MIN-SCALES GUARANTEE ----------\n","def make_bands(scales, min_scales=4):\n","    scales = np.asarray(scales, dtype=int)\n","    if len(scales) < (3 * min_scales):\n","        mid = int(np.median(scales))\n","        short = scales[scales <= mid]\n","        long  = scales[scales >= mid]\n","        return {\"short\": short, \"long\": long}\n","\n","    q1, q2 = np.quantile(scales, [1/3, 2/3])\n","    short = scales[scales <= q1]\n","    mid   = scales[(scales > q1) & (scales <= q2)]\n","    long  = scales[scales > q2]\n","\n","    bands = {\"short\": short, \"mid\": mid, \"long\": long}\n","\n","    if len(bands[\"mid\"]) < min_scales:\n","        if len(bands[\"short\"]) <= len(bands[\"long\"]):\n","            bands[\"short\"] = np.unique(np.concatenate([bands[\"short\"], bands[\"mid\"]]))\n","        else:\n","            bands[\"long\"]  = np.unique(np.concatenate([bands[\"mid\"], bands[\"long\"]]))\n","        del bands[\"mid\"]\n","\n","    for k in list(bands.keys()):\n","        if len(bands[k]) < min_scales:\n","            mid = int(np.median(scales))\n","            short = scales[scales <= mid]\n","            long  = scales[scales >= mid]\n","            return {\"short\": short, \"long\": long}\n","\n","    return bands\n","\n","bands = make_bands(candidate_scales, min_scales=4)\n","print(\"Bands:\", {k: v.tolist() for k, v in bands.items()})\n","\n","# ---------- SUMMARY / BOOTSTRAP ----------\n","def bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    n = len(x)\n","    if n < 5:\n","        return (np.nan, np.nan)\n","    rng = np.random.default_rng(seed)\n","    stats = np.empty(B, dtype=float)\n","    for b in range(B):\n","        stats[b] = np.median(x[rng.integers(0, n, size=n)])\n","    lo = float(np.quantile(stats, alpha/2))\n","    hi = float(np.quantile(stats, 1-alpha/2))\n","    return (lo, hi)\n","\n","def summarize(x):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    if len(x) == 0:\n","        return {}\n","    mean = float(np.mean(x))\n","    med  = float(np.median(x))\n","    sd   = float(np.std(x, ddof=1)) if len(x) > 1 else 0.0\n","    cv   = float(sd / mean) if mean != 0 else np.nan\n","    ci_lo, ci_hi = bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1)\n","    return {\n","        \"n\": int(len(x)),\n","        \"mean\": mean,\n","        \"median\": med,\n","        \"sd\": sd,\n","        \"CV\": cv,\n","        \"median_CI95\": (ci_lo, ci_hi),\n","        \"CI_width\": (ci_hi - ci_lo) if np.isfinite(ci_lo) and np.isfinite(ci_hi) else np.nan\n","    }\n","\n","# ---------- COMPUTE δ̂_TV PER BAND ----------\n","delta_per_band = {}\n","band_summaries = {}\n","for band, scales in bands.items():\n","    print(f\"Computing δ̂_TV band='{band}' scales={scales.tolist()} ...\")\n","    deltas = np.array([estimate_delta_TV(W[i], scales) for i in range(n_windows)], dtype=float)\n","    deltas = deltas[np.isfinite(deltas)]\n","    delta_per_band[band] = deltas\n","    band_summaries[band] = summarize(deltas)\n","\n","# ---------- NULLS (phi-targeted) ----------\n","def null_shuffle_ranks(w, rng):\n","    y = w.copy()\n","    rng.shuffle(y)\n","    return y\n","\n","def null_phase_randomize(w, rng):\n","    x = w - np.mean(w)\n","    X = np.fft.rfft(x)\n","    mag = np.abs(X)\n","    phase = np.angle(X)\n","    rand_phase = rng.uniform(-np.pi, np.pi, size=phase.shape)\n","    rand_phase[0] = phase[0]\n","    if len(rand_phase) > 1:\n","        rand_phase[-1] = phase[-1]\n","    Y = mag * np.exp(1j * rand_phase)\n","    return np.fft.irfft(Y, n=len(x))\n","\n","def null_random_monotone(L, rng):\n","    steps = np.abs(rng.normal(size=L))\n","    y = np.cumsum(steps)\n","    return (y - y.min()) / (y.max() - y.min() + 1e-12)\n","\n","def null_medians_for_band(kind, scales, B=200, seed=123, print_every=25):\n","    rng = np.random.default_rng(seed)\n","    meds = np.empty(B, dtype=float)\n","    for b in range(B):\n","        if (b % print_every) == 0:\n","            print(f\"[{kind}] {b}/{B}\")\n","        Dtmp = []\n","        for i in range(n_windows):\n","            w = W[i]\n","            if kind == \"shuffle\":\n","                w0 = null_shuffle_ranks(w, rng)\n","            elif kind == \"phase\":\n","                w0 = null_phase_randomize(w, rng)\n","            elif kind == \"monotone\":\n","                w0 = null_random_monotone(len(w), rng)\n","            else:\n","                raise ValueError(\"Unknown null kind.\")\n","            d = estimate_delta_TV(w0, scales)\n","            if np.isfinite(d):\n","                Dtmp.append(d)\n","        meds[b] = np.median(Dtmp) if len(Dtmp) else np.nan\n","    return meds[np.isfinite(meds)]\n","\n","null_kinds = [\"shuffle\", \"phase\", \"monotone\"]\n","B_NULL = 200 if not DEMO_MODE else 40  # demo runs faster\n","\n","pvals_per_band = {}\n","null_summary_per_band = {}\n","\n","for band, scales in bands.items():\n","    obs_med = band_summaries[band].get(\"median\", np.nan)\n","    if not np.isfinite(obs_med):\n","        continue\n","    print(f\"\\n=== Nulls: band '{band}' obs_median={obs_med:.6f} |obs-φ|={abs(obs_med-PHI):.6f} ===\")\n","    pvals, nsum = {}, {}\n","    for kind in null_kinds:\n","        nd = null_medians_for_band(kind, scales, B=B_NULL, seed=123, print_every=max(5, B_NULL//6))\n","        if len(nd) == 0:\n","            pvals[kind] = np.nan\n","            nsum[kind] = {}\n","            continue\n","        dev_obs = abs(obs_med - PHI)\n","        dev_null = np.abs(nd - PHI)\n","        p = float((np.sum(dev_null <= dev_obs) + 1) / (len(dev_null) + 1))\n","        pvals[kind] = p\n","        nsum[kind] = {\n","            \"n\": int(len(nd)),\n","            \"median\": float(np.median(nd)),\n","            \"CI95\": (float(np.quantile(nd, 0.025)), float(np.quantile(nd, 0.975))),\n","        }\n","        print(f\"  {kind:8s} null_median={nsum[kind]['median']:.6f}  p_phi={p:.6g}\")\n","    pvals_per_band[band] = pvals\n","    null_summary_per_band[band] = nsum\n","\n","# ---------- LIGHTWEIGHT PERTURBATION MEDIAN TRACKS ----------\n","def shift_window_edgepad(x, k):\n","    x = np.asarray(x)\n","    if k == 0:\n","        return x.copy()\n","    if k > 0:\n","        return np.concatenate([np.full(k, x[0]), x[:-k]])\n","    k2 = -k\n","    return np.concatenate([x[k2:], np.full(k2, x[-1])])\n","\n","noise_levels = [0.0, 0.05, 0.10]\n","jitter_shifts = [-3, -2, -1, 0, 1, 2, 3]\n","\n","sensitivity_per_band = {}\n","rng_sens = np.random.default_rng(999)\n","\n","for band, scales in bands.items():\n","    sens = {\"noise_median\": {}, \"jitter_median\": {}}\n","    for sigma in noise_levels:\n","        Wn = W + rng_sens.normal(0.0, sigma, size=W.shape)\n","        deltas = np.array([estimate_delta_TV(Wn[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"noise_median\"][sigma] = float(np.median(deltas)) if len(deltas) else np.nan\n","    for sh in jitter_shifts:\n","        Wj = np.vstack([shift_window_edgepad(W[i], sh) for i in range(n_windows)])\n","        deltas = np.array([estimate_delta_TV(Wj[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"jitter_median\"][sh] = float(np.median(deltas)) if len(deltas) else np.nan\n","    sensitivity_per_band[band] = sens\n","\n","# ---------- BREATH (bounded drift) ----------\n","def breath_pass_from_medians(medians, max_step=0.20):\n","    medians = np.asarray(medians, dtype=float)\n","    if not np.all(np.isfinite(medians)):\n","        return False\n","    steps = np.abs(np.diff(medians))\n","    return bool(np.all(steps <= max_step))\n","\n","band_order = list(bands.keys())\n","band_medians = [band_summaries[b].get(\"median\", np.nan) for b in band_order]\n","breath_pass = bool(breath_pass_from_medians(band_medians, max_step=0.20))\n","\n","# ---------- DECISIONS ----------\n","def structure_gate(summary, pvals, ciw_max=0.08, p_thresh=0.01):\n","    # NOTE: Structure gate intentionally does NOT enforce a strict CV cutoff.\n","    if not summary:\n","        return False\n","    if not (np.isfinite(summary.get(\"CI_width\", np.nan)) and summary[\"CI_width\"] <= ciw_max):\n","        return False\n","    if not any(np.isfinite(p) and p < p_thresh for p in pvals.values()):\n","        return False\n","    return True\n","\n","def phi_local_gate(summary, tol=0.05):\n","    med = summary.get(\"median\", np.nan)\n","    return bool(np.isfinite(med) and abs(med - PHI) <= tol)\n","\n","decisions = {}\n","for band in bands.keys():\n","    summary = band_summaries.get(band, {})\n","    pvals   = pvals_per_band.get(band, {})\n","    null_rejects = [k for k, p in pvals.items() if np.isfinite(p) and p < 0.01]\n","    decisions[band] = {\n","        \"structure?\": bool(structure_gate(summary, pvals)),\n","        \"φ-local?\": bool(phi_local_gate(summary, tol=0.05)),\n","        \"null_rejects\": null_rejects,\n","        \"breath_pass_global\": breath_pass,\n","    }\n","\n","# ---------- REGIME MAP TABLE ----------\n","regime_map_table = []\n","for band in bands.keys():\n","    regime_map_table.append({\n","        \"Band\": band,\n","        \"median\": band_summaries.get(band, {}).get(\"median\", np.nan),\n","        \"CI_width\": band_summaries.get(band, {}).get(\"CI_width\", np.nan),\n","        \"CV\": band_summaries.get(band, {}).get(\"CV\", np.nan),\n","        \"structure?\": \"Yes\" if decisions[band][\"structure?\"] else \"No\",\n","        \"φ-local?\": \"Yes\" if decisions[band][\"φ-local?\"] else \"No\",\n","        \"null_rejects\": \", \".join(decisions[band][\"null_rejects\"]),\n","    })\n","\n","# ---------- REPORT + EXPORT ----------\n","report = {\n","    \"Description\": \"δ̂_TV is the multiscale total-variation scaling exponent of the peak-centered, rank-normalized H3a signature windows, quantifying the roughness of their rank-order profile across coarse-graining scales.\",\n","    \"TensorSource\": name_used,\n","    \"DEMO_MODE\": bool(DEMO_MODE),\n","    \"PHI\": float(PHI),\n","    \"candidate_scales\": candidate_scales.tolist(),\n","    \"bands\": {k: v.tolist() for k, v in bands.items()},\n","    \"band_summaries\": band_summaries,\n","    \"null_phi_targeted\": {\n","        \"B_NULL\": int(B_NULL),\n","        \"summary_per_band\": null_summary_per_band,\n","        \"p_values_one_sided_per_band\": pvals_per_band,\n","        \"note\": \"p = P_null(|median_null - φ| ≤ |median_obs - φ|); lower → stronger evidence of nontrivial φ proximity\"\n","    },\n","    \"sensitivity_per_band\": sensitivity_per_band,\n","    \"breath_pass_global\": bool(breath_pass),\n","    \"decisions\": decisions,\n","    \"regime_map_table\": regime_map_table\n","}\n","\n","print(\"\\n==============================\")\n","print(\"REGIME MAP (copy/paste this)\")\n","print(\"==============================\")\n","for row in regime_map_table:\n","    print(row)\n","\n","with open(\"report.json\", \"w\") as f:\n","    json.dump(report, f, indent=2)\n","\n","print(\"\\nSaved: report.json\")\n","\n","report"]},{"cell_type":"markdown","metadata":{"id":"xUhy7lZTG-tw"},"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","\n","**Runtime → Run all.**\n","\n","This notebook:\n","1. Auto-detects your H3a rank-normalized signature window tensor if it exists in memory.\n","2. If not found, offers a one-click upload of a `.npy` or `.npz` tensor.\n","3. If neither is available, runs in clearly-labeled DEMO MODE.\n","\n","Outputs a **Regime Map table** plus a saved `report.json`.\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":108},"outputId":"2a3a2512-fb63-47b9-9ead-8c4ecfa41214","id":"uAK9lannG-tx"},"outputs":[{"name":"stdout","output_type":"stream","text":["No H3a tensor found in memory.\n","OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\n","OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\n"]},{"data":{"text/html":["\n","     <input type=\"file\" id=\"files-a3650acc-3e3e-4a92-8e70-1f28abbfd529\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-a3650acc-3e3e-4a92-8e70-1f28abbfd529\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "],"text/plain":["<IPython.core.display.HTML object>"]},"metadata":{},"output_type":"display_data"}],"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","# Runtime → Run all\n","#\n","# Purpose:\n","#   (1) Detect stable multiscale structure in H3a rank‑normalized signature windows\n","#   (2) Map where φ appears as a regime‑local attractor under null + perturbation controls\n","#\n","# What this notebook does NOT do:\n","#   - no mechanism claim\n","#   - no δ̂_TV → Hurst conversion claim\n","#   - no conflation with FUNt theoretical D≈1.2\n","#\n","# INPUT EXPECTATION:\n","#   A 2D tensor (n_windows, L), typically values in [0,1], e.g. (1278, 81).\n","#\n","# EASY BUTTON behavior:\n","#   A) If tensor already exists in memory under common upstream variable names, it auto‑uses it.\n","#   B) If not, it offers a one‑click upload of .npy or .npz (Colab).\n","#   C) If neither is available, it runs DEMO MODE (clearly labeled) so outputs appear.\n","\n","import numpy as np, os, json\n","\n","PHI = (1 + np.sqrt(5)) / 2\n","\n","# -------------------------\n","# 0) INPUT RESOLUTION (NO NAMEERROR)\n","# -------------------------\n","CANDIDATES = [\n","    \"H3a_windows_ranknorm\",\n","    \"windows_ranked_aligned\",\n","    \"signature_windows_final\",\n","    \"aligned_ranknorm_windows\",\n","    \"peak_centered_ranknorm\",\n","    \"W_normalized\",\n","    \"rank_windows_clean\",\n","]\n","\n","def _resolve_from_globals():\n","    g = globals()\n","    for name in CANDIDATES:\n","        if name in g:\n","            v = g[name]\n","            try:\n","                a = np.asarray(v, dtype=float)\n","                if a.ndim == 2 and a.shape[1] >= 16:\n","                    return name, a\n","            except Exception:\n","                pass\n","    return None, None\n","\n","name_used, signature_windows = _resolve_from_globals()\n","DEMO_MODE = False\n","\n","# Optional local path (if user wants to set it)\n","TENSOR_PATH = \"\"  # e.g., \"/content/H3a_windows_ranknorm.npy\" or \".npz\"\n","\n","if signature_windows is None and TENSOR_PATH and os.path.exists(TENSOR_PATH):\n","    if TENSOR_PATH.endswith(\".npy\"):\n","        signature_windows = np.load(TENSOR_PATH)\n","        name_used = f\"loaded:{TENSOR_PATH}\"\n","    elif TENSOR_PATH.endswith(\".npz\"):\n","        z = np.load(TENSOR_PATH)\n","        key = list(z.keys())[0]\n","        signature_windows = z[key]\n","        name_used = f\"loaded:{TENSOR_PATH}[{key}]\"\n","    else:\n","        raise ValueError(\"TENSOR_PATH must end in .npy or .npz\")\n","\n","# Colab upload helper (safe: user-controlled upload; no external calls)\n","if signature_windows is None:\n","    try:\n","        from google.colab import files\n","        print(\"No H3a tensor found in memory.\")\n","        print(\"OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\")\n","        print(\"OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\")\n","        up = files.upload()\n","        if up:\n","            fname = list(up.keys())[0]\n","            if fname.endswith(\".npy\"):\n","                signature_windows = np.load(fname)\n","                name_used = f\"uploaded:{fname}\"\n","            elif fname.endswith(\".npz\"):\n","                z = np.load(fname)\n","                key = list(z.keys())[0]\n","                signature_windows = z[key]\n","                name_used = f\"uploaded:{fname}[{key}]\"\n","            else:\n","                raise ValueError(\"Upload must be .npy or .npz containing the tensor.\")\n","    except Exception:\n","        pass\n","\n","# DEMO MODE fallback\n","if signature_windows is None:\n","    DEMO_MODE = True\n","    signature_windows = np.random.rand(400, 81)  # small-ish so it runs quickly anywhere\n","    name_used = \"DEMO_MODE_random_(400,81)\"\n","\n","W = np.asarray(signature_windows, dtype=float)\n","if W.ndim == 1:\n","    W = W[None, :]\n","n_windows, L = W.shape\n","\n","print(\"========================================\")\n","print(\"H3a δ̂_TV Regime Map — INPUT STATUS\")\n","print(\"========================================\")\n","print(\"Tensor source:\", name_used)\n","print(\"DEMO_MODE:\", DEMO_MODE)\n","print(\"Shape:\", W.shape)\n","print(\"Range:\", float(np.nanmin(W)), \"to\", float(np.nanmax(W)))\n","print(\"PHI:\", float(PHI))\n","assert L >= 16, \"Windows too short for multiscale slope fits.\"\n","\n","# -------------------------\n","# 1) REGIME MAP DIAGNOSTIC (OBSERVE‑ONLY)\n","# -------------------------\n","\n","# ---------- CORE ESTIMATOR: δ̂_TV ----------\n","def block_average(x, m):\n","    n = (len(x) // m) * m\n","    if n <= 0:\n","        return np.array([], dtype=float)\n","    return x[:n].reshape(-1, m).mean(axis=1)\n","\n","def total_variation(x):\n","    if len(x) < 2:\n","        return np.nan\n","    return float(np.sum(np.abs(np.diff(x))))\n","\n","def estimate_delta_TV(window, scales):\n","    eps_list, var_list = [], []\n","    for m in scales:\n","        y = block_average(window, int(m))\n","        v = total_variation(y)\n","        if np.isfinite(v) and v > 0 and len(y) >= 4:\n","            eps_list.append(float(m))\n","            var_list.append(float(v))\n","    if len(var_list) < 4:\n","        return np.nan\n","    log_eps = np.log(np.array(eps_list))\n","    log_var = np.log(np.array(var_list))\n","    slope, _ = np.polyfit(log_eps, log_var, 1)\n","    return float(-slope)\n","\n","# ---------- SCALE LADDER (min block size = 2) ----------\n","max_m = max(2, L // 4)\n","raw = np.logspace(np.log10(2), np.log10(max_m), num=10)\n","candidate_scales = np.unique(np.clip(np.round(raw), 2, max_m).astype(int))\n","candidate_scales = candidate_scales[candidate_scales >= 2]\n","print(\"candidate_scales:\", candidate_scales.tolist())\n","\n","# ---------- BAND SPLIT with MIN-SCALES GUARANTEE ----------\n","def make_bands(scales, min_scales=4):\n","    scales = np.asarray(scales, dtype=int)\n","    if len(scales) < (3 * min_scales):\n","        mid = int(np.median(scales))\n","        short = scales[scales <= mid]\n","        long  = scales[scales >= mid]\n","        return {\"short\": short, \"long\": long}\n","\n","    q1, q2 = np.quantile(scales, [1/3, 2/3])\n","    short = scales[scales <= q1]\n","    mid   = scales[(scales > q1) & (scales <= q2)]\n","    long  = scales[scales > q2]\n","\n","    bands = {\"short\": short, \"mid\": mid, \"long\": long}\n","\n","    if len(bands[\"mid\"]) < min_scales:\n","        if len(bands[\"short\"]) <= len(bands[\"long\"]):\n","            bands[\"short\"] = np.unique(np.concatenate([bands[\"short\"], bands[\"mid\"]]))\n","        else:\n","            bands[\"long\"]  = np.unique(np.concatenate([bands[\"mid\"], bands[\"long\"]]))\n","        del bands[\"mid\"]\n","\n","    for k in list(bands.keys()):\n","        if len(bands[k]) < min_scales:\n","            mid = int(np.median(scales))\n","            short = scales[scales <= mid]\n","            long  = scales[scales >= mid]\n","            return {\"short\": short, \"long\": long}\n","\n","    return bands\n","\n","bands = make_bands(candidate_scales, min_scales=4)\n","print(\"Bands:\", {k: v.tolist() for k, v in bands.items()})\n","\n","# ---------- SUMMARY / BOOTSTRAP ----------\n","def bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    n = len(x)\n","    if n < 5:\n","        return (np.nan, np.nan)\n","    rng = np.random.default_rng(seed)\n","    stats = np.empty(B, dtype=float)\n","    for b in range(B):\n","        stats[b] = np.median(x[rng.integers(0, n, size=n)])\n","    lo = float(np.quantile(stats, alpha/2))\n","    hi = float(np.quantile(stats, 1-alpha/2))\n","    return (lo, hi)\n","\n","def summarize(x):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    if len(x) == 0:\n","        return {}\n","    mean = float(np.mean(x))\n","    med  = float(np.median(x))\n","    sd   = float(np.std(x, ddof=1)) if len(x) > 1 else 0.0\n","    cv   = float(sd / mean) if mean != 0 else np.nan\n","    ci_lo, ci_hi = bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1)\n","    return {\n","        \"n\": int(len(x)),\n","        \"mean\": mean,\n","        \"median\": med,\n","        \"sd\": sd,\n","        \"CV\": cv,\n","        \"median_CI95\": (ci_lo, ci_hi),\n","        \"CI_width\": (ci_hi - ci_lo) if np.isfinite(ci_lo) and np.isfinite(ci_hi) else np.nan\n","    }\n","\n","# ---------- COMPUTE δ̂_TV PER BAND ----------\n","delta_per_band = {}\n","band_summaries = {}\n","for band, scales in bands.items():\n","    print(f\"Computing δ̂_TV band='{band}' scales={scales.tolist()} ...\")\n","    deltas = np.array([estimate_delta_TV(W[i], scales) for i in range(n_windows)], dtype=float)\n","    deltas = deltas[np.isfinite(deltas)]\n","    delta_per_band[band] = deltas\n","    band_summaries[band] = summarize(deltas)\n","\n","# ---------- NULLS (phi-targeted) ----------\n","def null_shuffle_ranks(w, rng):\n","    y = w.copy()\n","    rng.shuffle(y)\n","    return y\n","\n","def null_phase_randomize(w, rng):\n","    x = w - np.mean(w)\n","    X = np.fft.rfft(x)\n","    mag = np.abs(X)\n","    phase = np.angle(X)\n","    rand_phase = rng.uniform(-np.pi, np.pi, size=phase.shape)\n","    rand_phase[0] = phase[0]\n","    if len(rand_phase) > 1:\n","        rand_phase[-1] = phase[-1]\n","    Y = mag * np.exp(1j * rand_phase)\n","    return np.fft.irfft(Y, n=len(x))\n","\n","def null_random_monotone(L, rng):\n","    steps = np.abs(rng.normal(size=L))\n","    y = np.cumsum(steps)\n","    return (y - y.min()) / (y.max() - y.min() + 1e-12)\n","\n","def null_medians_for_band(kind, scales, B=200, seed=123, print_every=25):\n","    rng = np.random.default_rng(seed)\n","    meds = np.empty(B, dtype=float)\n","    for b in range(B):\n","        if (b % print_every) == 0:\n","            print(f\"[{kind}] {b}/{B}\")\n","        Dtmp = []\n","        for i in range(n_windows):\n","            w = W[i]\n","            if kind == \"shuffle\":\n","                w0 = null_shuffle_ranks(w, rng)\n","            elif kind == \"phase\":\n","                w0 = null_phase_randomize(w, rng)\n","            elif kind == \"monotone\":\n","                w0 = null_random_monotone(len(w), rng)\n","            else:\n","                raise ValueError(\"Unknown null kind.\")\n","            d = estimate_delta_TV(w0, scales)\n","            if np.isfinite(d):\n","                Dtmp.append(d)\n","        meds[b] = np.median(Dtmp) if len(Dtmp) else np.nan\n","    return meds[np.isfinite(meds)]\n","\n","null_kinds = [\"shuffle\", \"phase\", \"monotone\"]\n","B_NULL = 200 if not DEMO_MODE else 40  # demo runs faster\n","\n","pvals_per_band = {}\n","null_summary_per_band = {}\n","\n","for band, scales in bands.items():\n","    obs_med = band_summaries[band].get(\"median\", np.nan)\n","    if not np.isfinite(obs_med):\n","        continue\n","    print(f\"\\n=== Nulls: band '{band}' obs_median={obs_med:.6f} |obs-φ|={abs(obs_med-PHI):.6f} ===\")\n","    pvals, nsum = {}, {}\n","    for kind in null_kinds:\n","        nd = null_medians_for_band(kind, scales, B=B_NULL, seed=123, print_every=max(5, B_NULL//6))\n","        if len(nd) == 0:\n","            pvals[kind] = np.nan\n","            nsum[kind] = {}\n","            continue\n","        dev_obs = abs(obs_med - PHI)\n","        dev_null = np.abs(nd - PHI)\n","        p = float((np.sum(dev_null <= dev_obs) + 1) / (len(dev_null) + 1))\n","        pvals[kind] = p\n","        nsum[kind] = {\n","            \"n\": int(len(nd)),\n","            \"median\": float(np.median(nd)),\n","            \"CI95\": (float(np.quantile(nd, 0.025)), float(np.quantile(nd, 0.975))),\n","        }\n","        print(f\"  {kind:8s} null_median={nsum[kind]['median']:.6f}  p_phi={p:.6g}\")\n","    pvals_per_band[band] = pvals\n","    null_summary_per_band[band] = nsum\n","\n","# ---------- LIGHTWEIGHT PERTURBATION MEDIAN TRACKS ----------\n","def shift_window_edgepad(x, k):\n","    x = np.asarray(x)\n","    if k == 0:\n","        return x.copy()\n","    if k > 0:\n","        return np.concatenate([np.full(k, x[0]), x[:-k]])\n","    k2 = -k\n","    return np.concatenate([x[k2:], np.full(k2, x[-1])])\n","\n","noise_levels = [0.0, 0.05, 0.10]\n","jitter_shifts = [-3, -2, -1, 0, 1, 2, 3]\n","\n","sensitivity_per_band = {}\n","rng_sens = np.random.default_rng(999)\n","\n","for band, scales in bands.items():\n","    sens = {\"noise_median\": {}, \"jitter_median\": {}}\n","    for sigma in noise_levels:\n","        Wn = W + rng_sens.normal(0.0, sigma, size=W.shape)\n","        deltas = np.array([estimate_delta_TV(Wn[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"noise_median\"][sigma] = float(np.median(deltas)) if len(deltas) else np.nan\n","    for sh in jitter_shifts:\n","        Wj = np.vstack([shift_window_edgepad(W[i], sh) for i in range(n_windows)])\n","        deltas = np.array([estimate_delta_TV(Wj[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"jitter_median\"][sh] = float(np.median(deltas)) if len(deltas) else np.nan\n","    sensitivity_per_band[band] = sens\n","\n","# ---------- BREATH (bounded drift) ----------\n","def breath_pass_from_medians(medians, max_step=0.20):\n","    medians = np.asarray(medians, dtype=float)\n","    if not np.all(np.isfinite(medians)):\n","        return False\n","    steps = np.abs(np.diff(medians))\n","    return bool(np.all(steps <= max_step))\n","\n","band_order = list(bands.keys())\n","band_medians = [band_summaries[b].get(\"median\", np.nan) for b in band_order]\n","breath_pass = bool(breath_pass_from_medians(band_medians, max_step=0.20))\n","\n","# ---------- DECISIONS ----------\n","def structure_gate(summary, pvals, ciw_max=0.08, p_thresh=0.01):\n","    # NOTE: Structure gate intentionally does NOT enforce a strict CV cutoff.\n","    if not summary:\n","        return False\n","    if not (np.isfinite(summary.get(\"CI_width\", np.nan)) and summary[\"CI_width\"] <= ciw_max):\n","        return False\n","    if not any(np.isfinite(p) and p < p_thresh for p in pvals.values()):\n","        return False\n","    return True\n","\n","def phi_local_gate(summary, tol=0.05):\n","    med = summary.get(\"median\", np.nan)\n","    return bool(np.isfinite(med) and abs(med - PHI) <= tol)\n","\n","decisions = {}\n","for band in bands.keys():\n","    summary = band_summaries.get(band, {})\n","    pvals   = pvals_per_band.get(band, {})\n","    null_rejects = [k for k, p in pvals.items() if np.isfinite(p) and p < 0.01]\n","    decisions[band] = {\n","        \"structure?\": bool(structure_gate(summary, pvals)),\n","        \"φ-local?\": bool(phi_local_gate(summary, tol=0.05)),\n","        \"null_rejects\": null_rejects,\n","        \"breath_pass_global\": breath_pass,\n","    }\n","\n","# ---------- REGIME MAP TABLE ----------\n","regime_map_table = []\n","for band in bands.keys():\n","    regime_map_table.append({\n","        \"Band\": band,\n","        \"median\": band_summaries.get(band, {}).get(\"median\", np.nan),\n","        \"CI_width\": band_summaries.get(band, {}).get(\"CI_width\", np.nan),\n","        \"CV\": band_summaries.get(band, {}).get(\"CV\", np.nan),\n","        \"structure?\": \"Yes\" if decisions[band][\"structure?\"] else \"No\",\n","        \"φ-local?\": \"Yes\" if decisions[band][\"φ-local?\"] else \"No\",\n","        \"null_rejects\": \", \".join(decisions[band][\"null_rejects\"]),\n","    })\n","\n","# ---------- REPORT + EXPORT ----------\n","report = {\n","    \"Description\": \"δ̂_TV is the multiscale total-variation scaling exponent of the peak-centered, rank-normalized H3a signature windows, quantifying the roughness of their rank-order profile across coarse-graining scales.\",\n","    \"TensorSource\": name_used,\n","    \"DEMO_MODE\": bool(DEMO_MODE),\n","    \"PHI\": float(PHI),\n","    \"candidate_scales\": candidate_scales.tolist(),\n","    \"bands\": {k: v.tolist() for k, v in bands.items()},\n","    \"band_summaries\": band_summaries,\n","    \"null_phi_targeted\": {\n","        \"B_NULL\": int(B_NULL),\n","        \"summary_per_band\": null_summary_per_band,\n","        \"p_values_one_sided_per_band\": pvals_per_band,\n","        \"note\": \"p = P_null(|median_null - φ| ≤ |median_obs - φ|); lower → stronger evidence of nontrivial φ proximity\"\n","    },\n","    \"sensitivity_per_band\": sensitivity_per_band,\n","    \"breath_pass_global\": bool(breath_pass),\n","    \"decisions\": decisions,\n","    \"regime_map_table\": regime_map_table\n","}\n","\n","print(\"\\n==============================\")\n","print(\"REGIME MAP (copy/paste this)\")\n","print(\"==============================\")\n","for row in regime_map_table:\n","    print(row)\n","\n","with open(\"report.json\", \"w\") as f:\n","    json.dump(report, f, indent=2)\n","\n","print(\"\\nSaved: report.json\")\n","\n","report"]},{"cell_type":"markdown","metadata":{"id":"_iOKf_RFHFNV"},"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","\n","**Runtime → Run all.**\n","\n","This notebook:\n","1. Auto-detects your H3a rank-normalized signature window tensor if it exists in memory.\n","2. If not found, offers a one-click upload of a `.npy` or `.npz` tensor.\n","3. If neither is available, runs in clearly-labeled DEMO MODE.\n","\n","Outputs a **Regime Map table** plus a saved `report.json`.\n"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"base_uri":"https://localhost:8080/","height":108},"outputId":"2a3a2512-fb63-47b9-9ead-8c4ecfa41214","id":"usfvKy5UHFNW"},"outputs":[{"name":"stdout","output_type":"stream","text":["No H3a tensor found in memory.\n","OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\n","OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\n"]},{"data":{"text/html":["\n","     <input type=\"file\" id=\"files-a3650acc-3e3e-4a92-8e70-1f28abbfd529\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-a3650acc-3e3e-4a92-8e70-1f28abbfd529\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "],"text/plain":["<IPython.core.display.HTML object>"]},"metadata":{},"output_type":"display_data"}],"source":["# H3a δ̂_TV Regime Map — EASY BUTTON (OBSERVE‑ONLY)\n","# Runtime → Run all\n","#\n","# Purpose:\n","#   (1) Detect stable multiscale structure in H3a rank‑normalized signature windows\n","#   (2) Map where φ appears as a regime‑local attractor under null + perturbation controls\n","#\n","# What this notebook does NOT do:\n","#   - no mechanism claim\n","#   - no δ̂_TV → Hurst conversion claim\n","#   - no conflation with FUNt theoretical D≈1.2\n","#\n","# INPUT EXPECTATION:\n","#   A 2D tensor (n_windows, L), typically values in [0,1], e.g. (1278, 81).\n","#\n","# EASY BUTTON behavior:\n","#   A) If tensor already exists in memory under common upstream variable names, it auto‑uses it.\n","#   B) If not, it offers a one‑click upload of .npy or .npz (Colab).\n","#   C) If neither is available, it runs DEMO MODE (clearly labeled) so outputs appear.\n","\n","import numpy as np, os, json\n","\n","PHI = (1 + np.sqrt(5)) / 2\n","\n","# -------------------------\n","# 0) INPUT RESOLUTION (NO NAMEERROR)\n","# -------------------------\n","CANDIDATES = [\n","    \"H3a_windows_ranknorm\",\n","    \"windows_ranked_aligned\",\n","    \"signature_windows_final\",\n","    \"aligned_ranknorm_windows\",\n","    \"peak_centered_ranknorm\",\n","    \"W_normalized\",\n","    \"rank_windows_clean\",\n","]\n","\n","def _resolve_from_globals():\n","    g = globals()\n","    for name in CANDIDATES:\n","        if name in g:\n","            v = g[name]\n","            try:\n","                a = np.asarray(v, dtype=float)\n","                if a.ndim == 2 and a.shape[1] >= 16:\n","                    return name, a\n","            except Exception:\n","                pass\n","    return None, None\n","\n","name_used, signature_windows = _resolve_from_globals()\n","DEMO_MODE = False\n","\n","# Optional local path (if user wants to set it)\n","TENSOR_PATH = \"\"  # e.g., \"/content/H3a_windows_ranknorm.npy\" or \".npz\"\n","\n","if signature_windows is None and TENSOR_PATH and os.path.exists(TENSOR_PATH):\n","    if TENSOR_PATH.endswith(\".npy\"):\n","        signature_windows = np.load(TENSOR_PATH)\n","        name_used = f\"loaded:{TENSOR_PATH}\"\n","    elif TENSOR_PATH.endswith(\".npz\"):\n","        z = np.load(TENSOR_PATH)\n","        key = list(z.keys())[0]\n","        signature_windows = z[key]\n","        name_used = f\"loaded:{TENSOR_PATH}[{key}]\"\n","    else:\n","        raise ValueError(\"TENSOR_PATH must end in .npy or .npz\")\n","\n","# Colab upload helper (safe: user-controlled upload; no external calls)\n","if signature_windows is None:\n","    try:\n","        from google.colab import files\n","        print(\"No H3a tensor found in memory.\")\n","        print(\"OPTION A (recommended): run your upstream H3a extraction cell, then re-run this cell.\")\n","        print(\"OPTION B: upload a saved tensor (.npy or .npz) now. If you skip, DEMO MODE will run.\")\n","        up = files.upload()\n","        if up:\n","            fname = list(up.keys())[0]\n","            if fname.endswith(\".npy\"):\n","                signature_windows = np.load(fname)\n","                name_used = f\"uploaded:{fname}\"\n","            elif fname.endswith(\".npz\"):\n","                z = np.load(fname)\n","                key = list(z.keys())[0]\n","                signature_windows = z[key]\n","                name_used = f\"uploaded:{fname}[{key}]\"\n","            else:\n","                raise ValueError(\"Upload must be .npy or .npz containing the tensor.\")\n","    except Exception:\n","        pass\n","\n","# DEMO MODE fallback\n","if signature_windows is None:\n","    DEMO_MODE = True\n","    signature_windows = np.random.rand(400, 81)  # small-ish so it runs quickly anywhere\n","    name_used = \"DEMO_MODE_random_(400,81)\"\n","\n","W = np.asarray(signature_windows, dtype=float)\n","if W.ndim == 1:\n","    W = W[None, :]\n","n_windows, L = W.shape\n","\n","print(\"========================================\")\n","print(\"H3a δ̂_TV Regime Map — INPUT STATUS\")\n","print(\"========================================\")\n","print(\"Tensor source:\", name_used)\n","print(\"DEMO_MODE:\", DEMO_MODE)\n","print(\"Shape:\", W.shape)\n","print(\"Range:\", float(np.nanmin(W)), \"to\", float(np.nanmax(W)))\n","print(\"PHI:\", float(PHI))\n","assert L >= 16, \"Windows too short for multiscale slope fits.\"\n","\n","# -------------------------\n","# 1) REGIME MAP DIAGNOSTIC (OBSERVE‑ONLY)\n","# -------------------------\n","\n","# ---------- CORE ESTIMATOR: δ̂_TV ----------\n","def block_average(x, m):\n","    n = (len(x) // m) * m\n","    if n <= 0:\n","        return np.array([], dtype=float)\n","    return x[:n].reshape(-1, m).mean(axis=1)\n","\n","def total_variation(x):\n","    if len(x) < 2:\n","        return np.nan\n","    return float(np.sum(np.abs(np.diff(x))))\n","\n","def estimate_delta_TV(window, scales):\n","    eps_list, var_list = [], []\n","    for m in scales:\n","        y = block_average(window, int(m))\n","        v = total_variation(y)\n","        if np.isfinite(v) and v > 0 and len(y) >= 4:\n","            eps_list.append(float(m))\n","            var_list.append(float(v))\n","    if len(var_list) < 4:\n","        return np.nan\n","    log_eps = np.log(np.array(eps_list))\n","    log_var = np.log(np.array(var_list))\n","    slope, _ = np.polyfit(log_eps, log_var, 1)\n","    return float(-slope)\n","\n","# ---------- SCALE LADDER (min block size = 2) ----------\n","max_m = max(2, L // 4)\n","raw = np.logspace(np.log10(2), np.log10(max_m), num=10)\n","candidate_scales = np.unique(np.clip(np.round(raw), 2, max_m).astype(int))\n","candidate_scales = candidate_scales[candidate_scales >= 2]\n","print(\"candidate_scales:\", candidate_scales.tolist())\n","\n","# ---------- BAND SPLIT with MIN-SCALES GUARANTEE ----------\n","def make_bands(scales, min_scales=4):\n","    scales = np.asarray(scales, dtype=int)\n","    if len(scales) < (3 * min_scales):\n","        mid = int(np.median(scales))\n","        short = scales[scales <= mid]\n","        long  = scales[scales >= mid]\n","        return {\"short\": short, \"long\": long}\n","\n","    q1, q2 = np.quantile(scales, [1/3, 2/3])\n","    short = scales[scales <= q1]\n","    mid   = scales[(scales > q1) & (scales <= q2)]\n","    long  = scales[scales > q2]\n","\n","    bands = {\"short\": short, \"mid\": mid, \"long\": long}\n","\n","    if len(bands[\"mid\"]) < min_scales:\n","        if len(bands[\"short\"]) <= len(bands[\"long\"]):\n","            bands[\"short\"] = np.unique(np.concatenate([bands[\"short\"], bands[\"mid\"]]))\n","        else:\n","            bands[\"long\"]  = np.unique(np.concatenate([bands[\"mid\"], bands[\"long\"]]))\n","        del bands[\"mid\"]\n","\n","    for k in list(bands.keys()):\n","        if len(bands[k]) < min_scales:\n","            mid = int(np.median(scales))\n","            short = scales[scales <= mid]\n","            long  = scales[scales >= mid]\n","            return {\"short\": short, \"long\": long}\n","\n","    return bands\n","\n","bands = make_bands(candidate_scales, min_scales=4)\n","print(\"Bands:\", {k: v.tolist() for k, v in bands.items()})\n","\n","# ---------- SUMMARY / BOOTSTRAP ----------\n","def bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    n = len(x)\n","    if n < 5:\n","        return (np.nan, np.nan)\n","    rng = np.random.default_rng(seed)\n","    stats = np.empty(B, dtype=float)\n","    for b in range(B):\n","        stats[b] = np.median(x[rng.integers(0, n, size=n)])\n","    lo = float(np.quantile(stats, alpha/2))\n","    hi = float(np.quantile(stats, 1-alpha/2))\n","    return (lo, hi)\n","\n","def summarize(x):\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    if len(x) == 0:\n","        return {}\n","    mean = float(np.mean(x))\n","    med  = float(np.median(x))\n","    sd   = float(np.std(x, ddof=1)) if len(x) > 1 else 0.0\n","    cv   = float(sd / mean) if mean != 0 else np.nan\n","    ci_lo, ci_hi = bootstrap_median_ci(x, B=2000, alpha=0.05, seed=1)\n","    return {\n","        \"n\": int(len(x)),\n","        \"mean\": mean,\n","        \"median\": med,\n","        \"sd\": sd,\n","        \"CV\": cv,\n","        \"median_CI95\": (ci_lo, ci_hi),\n","        \"CI_width\": (ci_hi - ci_lo) if np.isfinite(ci_lo) and np.isfinite(ci_hi) else np.nan\n","    }\n","\n","# ---------- COMPUTE δ̂_TV PER BAND ----------\n","delta_per_band = {}\n","band_summaries = {}\n","for band, scales in bands.items():\n","    print(f\"Computing δ̂_TV band='{band}' scales={scales.tolist()} ...\")\n","    deltas = np.array([estimate_delta_TV(W[i], scales) for i in range(n_windows)], dtype=float)\n","    deltas = deltas[np.isfinite(deltas)]\n","    delta_per_band[band] = deltas\n","    band_summaries[band] = summarize(deltas)\n","\n","# ---------- NULLS (phi-targeted) ----------\n","def null_shuffle_ranks(w, rng):\n","    y = w.copy()\n","    rng.shuffle(y)\n","    return y\n","\n","def null_phase_randomize(w, rng):\n","    x = w - np.mean(w)\n","    X = np.fft.rfft(x)\n","    mag = np.abs(X)\n","    phase = np.angle(X)\n","    rand_phase = rng.uniform(-np.pi, np.pi, size=phase.shape)\n","    rand_phase[0] = phase[0]\n","    if len(rand_phase) > 1:\n","        rand_phase[-1] = phase[-1]\n","    Y = mag * np.exp(1j * rand_phase)\n","    return np.fft.irfft(Y, n=len(x))\n","\n","def null_random_monotone(L, rng):\n","    steps = np.abs(rng.normal(size=L))\n","    y = np.cumsum(steps)\n","    return (y - y.min()) / (y.max() - y.min() + 1e-12)\n","\n","def null_medians_for_band(kind, scales, B=200, seed=123, print_every=25):\n","    rng = np.random.default_rng(seed)\n","    meds = np.empty(B, dtype=float)\n","    for b in range(B):\n","        if (b % print_every) == 0:\n","            print(f\"[{kind}] {b}/{B}\")\n","        Dtmp = []\n","        for i in range(n_windows):\n","            w = W[i]\n","            if kind == \"shuffle\":\n","                w0 = null_shuffle_ranks(w, rng)\n","            elif kind == \"phase\":\n","                w0 = null_phase_randomize(w, rng)\n","            elif kind == \"monotone\":\n","                w0 = null_random_monotone(len(w), rng)\n","            else:\n","                raise ValueError(\"Unknown null kind.\")\n","            d = estimate_delta_TV(w0, scales)\n","            if np.isfinite(d):\n","                Dtmp.append(d)\n","        meds[b] = np.median(Dtmp) if len(Dtmp) else np.nan\n","    return meds[np.isfinite(meds)]\n","\n","null_kinds = [\"shuffle\", \"phase\", \"monotone\"]\n","B_NULL = 200 if not DEMO_MODE else 40  # demo runs faster\n","\n","pvals_per_band = {}\n","null_summary_per_band = {}\n","\n","for band, scales in bands.items():\n","    obs_med = band_summaries[band].get(\"median\", np.nan)\n","    if not np.isfinite(obs_med):\n","        continue\n","    print(f\"\\n=== Nulls: band '{band}' obs_median={obs_med:.6f} |obs-φ|={abs(obs_med-PHI):.6f} ===\")\n","    pvals, nsum = {}, {}\n","    for kind in null_kinds:\n","        nd = null_medians_for_band(kind, scales, B=B_NULL, seed=123, print_every=max(5, B_NULL//6))\n","        if len(nd) == 0:\n","            pvals[kind] = np.nan\n","            nsum[kind] = {}\n","            continue\n","        dev_obs = abs(obs_med - PHI)\n","        dev_null = np.abs(nd - PHI)\n","        p = float((np.sum(dev_null <= dev_obs) + 1) / (len(dev_null) + 1))\n","        pvals[kind] = p\n","        nsum[kind] = {\n","            \"n\": int(len(nd)),\n","            \"median\": float(np.median(nd)),\n","            \"CI95\": (float(np.quantile(nd, 0.025)), float(np.quantile(nd, 0.975))),\n","        }\n","        print(f\"  {kind:8s} null_median={nsum[kind]['median']:.6f}  p_phi={p:.6g}\")\n","    pvals_per_band[band] = pvals\n","    null_summary_per_band[band] = nsum\n","\n","# ---------- LIGHTWEIGHT PERTURBATION MEDIAN TRACKS ----------\n","def shift_window_edgepad(x, k):\n","    x = np.asarray(x)\n","    if k == 0:\n","        return x.copy()\n","    if k > 0:\n","        return np.concatenate([np.full(k, x[0]), x[:-k]])\n","    k2 = -k\n","    return np.concatenate([x[k2:], np.full(k2, x[-1])])\n","\n","noise_levels = [0.0, 0.05, 0.10]\n","jitter_shifts = [-3, -2, -1, 0, 1, 2, 3]\n","\n","sensitivity_per_band = {}\n","rng_sens = np.random.default_rng(999)\n","\n","for band, scales in bands.items():\n","    sens = {\"noise_median\": {}, \"jitter_median\": {}}\n","    for sigma in noise_levels:\n","        Wn = W + rng_sens.normal(0.0, sigma, size=W.shape)\n","        deltas = np.array([estimate_delta_TV(Wn[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"noise_median\"][sigma] = float(np.median(deltas)) if len(deltas) else np.nan\n","    for sh in jitter_shifts:\n","        Wj = np.vstack([shift_window_edgepad(W[i], sh) for i in range(n_windows)])\n","        deltas = np.array([estimate_delta_TV(Wj[i], scales) for i in range(n_windows)], dtype=float)\n","        deltas = deltas[np.isfinite(deltas)]\n","        sens[\"jitter_median\"][sh] = float(np.median(deltas)) if len(deltas) else np.nan\n","    sensitivity_per_band[band] = sens\n","\n","# ---------- BREATH (bounded drift) ----------\n","def breath_pass_from_medians(medians, max_step=0.20):\n","    medians = np.asarray(medians, dtype=float)\n","    if not np.all(np.isfinite(medians)):\n","        return False\n","    steps = np.abs(np.diff(medians))\n","    return bool(np.all(steps <= max_step))\n","\n","band_order = list(bands.keys())\n","band_medians = [band_summaries[b].get(\"median\", np.nan) for b in band_order]\n","breath_pass = bool(breath_pass_from_medians(band_medians, max_step=0.20))\n","\n","# ---------- DECISIONS ----------\n","def structure_gate(summary, pvals, ciw_max=0.08, p_thresh=0.01):\n","    # NOTE: Structure gate intentionally does NOT enforce a strict CV cutoff.\n","    if not summary:\n","        return False\n","    if not (np.isfinite(summary.get(\"CI_width\", np.nan)) and summary[\"CI_width\"] <= ciw_max):\n","        return False\n","    if not any(np.isfinite(p) and p < p_thresh for p in pvals.values()):\n","        return False\n","    return True\n","\n","def phi_local_gate(summary, tol=0.05):\n","    med = summary.get(\"median\", np.nan)\n","    return bool(np.isfinite(med) and abs(med - PHI) <= tol)\n","\n","decisions = {}\n","for band in bands.keys():\n","    summary = band_summaries.get(band, {})\n","    pvals   = pvals_per_band.get(band, {})\n","    null_rejects = [k for k, p in pvals.items() if np.isfinite(p) and p < 0.01]\n","    decisions[band] = {\n","        \"structure?\": bool(structure_gate(summary, pvals)),\n","        \"φ-local?\": bool(phi_local_gate(summary, tol=0.05)),\n","        \"null_rejects\": null_rejects,\n","        \"breath_pass_global\": breath_pass,\n","    }\n","\n","# ---------- REGIME MAP TABLE ----------\n","regime_map_table = []\n","for band in bands.keys():\n","    regime_map_table.append({\n","        \"Band\": band,\n","        \"median\": band_summaries.get(band, {}).get(\"median\", np.nan),\n","        \"CI_width\": band_summaries.get(band, {}).get(\"CI_width\", np.nan),\n","        \"CV\": band_summaries.get(band, {}).get(\"CV\", np.nan),\n","        \"structure?\": \"Yes\" if decisions[band][\"structure?\"] else \"No\",\n","        \"φ-local?\": \"Yes\" if decisions[band][\"φ-local?\"] else \"No\",\n","        \"null_rejects\": \", \".join(decisions[band][\"null_rejects\"]),\n","    })\n","\n","# ---------- REPORT + EXPORT ----------\n","report = {\n","    \"Description\": \"δ̂_TV is the multiscale total-variation scaling exponent of the peak-centered, rank-normalized H3a signature windows, quantifying the roughness of their rank-order profile across coarse-graining scales.\",\n","    \"TensorSource\": name_used,\n","    \"DEMO_MODE\": bool(DEMO_MODE),\n","    \"PHI\": float(PHI),\n","    \"candidate_scales\": candidate_scales.tolist(),\n","    \"bands\": {k: v.tolist() for k, v in bands.items()},\n","    \"band_summaries\": band_summaries,\n","    \"null_phi_targeted\": {\n","        \"B_NULL\": int(B_NULL),\n","        \"summary_per_band\": null_summary_per_band,\n","        \"p_values_one_sided_per_band\": pvals_per_band,\n","        \"note\": \"p = P_null(|median_null - φ| ≤ |median_obs - φ|); lower → stronger evidence of nontrivial φ proximity\"\n","    },\n","    \"sensitivity_per_band\": sensitivity_per_band,\n","    \"breath_pass_global\": bool(breath_pass),\n","    \"decisions\": decisions,\n","    \"regime_map_table\": regime_map_table\n","}\n","\n","print(\"\\n==============================\")\n","print(\"REGIME MAP (copy/paste this)\")\n","print(\"==============================\")\n","for row in regime_map_table:\n","    print(row)\n","\n","with open(\"report.json\", \"w\") as f:\n","    json.dump(report, f, indent=2)\n","\n","print(\"\\nSaved: report.json\")\n","\n","report"]}]}